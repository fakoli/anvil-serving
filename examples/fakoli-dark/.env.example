# Copy to examples/fakoli-dark/.env on Fakoli Dark and fill locally.
# The real .env file is gitignored.

# Stable compute roles. `anvil-serving init` fills these from `nvidia-smi`.
# Equal-VRAM cards use canonical UUID order, so runtime-index changes do not
# silently swap ownership.
COMPUTE_A_GPU_UUID=GPU-d0f446cf-1771-414c-e116-a39138798a8c
COMPUTE_B_GPU_UUID=GPU-f0c3bae2-f800-2c37-5bef-a6166b44c490

# Required by Gepard on first model download.
HF_TOKEN=

# Optional: leave unset/empty to use the compose-managed gepard-postgres store.
GEPARD_DATABASE_URL=

# Optional: set to 100.64.0.10 only when Mini must reach Gepard directly.
VOICE_TTS_CANDIDATE_PUBLISH=

# Set to this host's tailnet address (100.64.0.10) so Fakoli Mini's realtime
# proxy can reach the STT/TTS bridge ports (30110/30111); loopback-only default.
VOICE_AUDIO_PUBLISH=
