ARG BASE_IMAGE=obeliks/comfyui@sha256:c7bef1de5e5a611a446a2b7f8a3483cf8e870cfbb4ec38cdfa6de2b9b5c14da0
FROM ${BASE_IMAGE}

USER root

# ComfyUI's GLSL extras load ANGLE, which links against X11 even in this
# headless container. ffmpeg and the remaining GL libraries cover the common
# video, preview, and ControlNet custom-node paths.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ffmpeg \
        gcc \
        git \
        libegl1 \
        libgl1 \
        libgles2 \
        libglib2.0-0 \
        libc6-dev \
        libsm6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Exact revisions pin the add-on source trees. Their requirements still resolve
# from package indexes at build time; the constraints and final imports below
# protect the base CUDA stack but do not make the image bit-for-bit hermetic.
# Update revisions deliberately and rerun the import/probe gate; never update
# nodes at container startup. Manager remains available for inspection only.
ARG COMFYUI_MANAGER_REV=97421c49658aaa8cf6e64736a8cb21697db3f866
ARG IMPACT_PACK_REV=429d0159ad429e64d2b3916e6e7be9c22d025c3c
ARG VIDEO_HELPER_SUITE_REV=4ee72c065db22c9d96c2427954dc69e7b908444b
ARG KJNODES_REV=073efb07419f56cc714e099a82e49fbc23ad9263
ARG RGTHREE_REV=6b76ee6f2c5a007710b5a16f97c94330d6ecc871
ARG ESSENTIALS_REV=9d9f4bedfc9f0321c19faf71855e228c93bd0dc9
ARG CONTROLNET_AUX_REV=e8b689a513c3e6b63edc44066560ca5919c0576e
ARG CRYSTOOLS_REV=2f18256c5b5063937106f29a8e0a7db3ae3869b7
ARG CCTECH_GGUF_LOADER_REV=142c614fe6852f18a513742cc098fd13d72320a9
ARG COMFYUI_IMAGE_REV=a361e133c3ec5fcbd6e1c48c4340cd0e093bd645
ARG COMFYUI_RELEASE_REV=85eecc613aac153c2a3dfd6322434597c048ea05
ARG INSTALLER_SHA256=709343424884a495404191ef0984b85a7863bd8f76fa2573b3bd39e40f8ac14b

ARG COMFYUI_MANAGER_REQUIREMENTS_SHA256=79e080784300a01c9057d0a1ad55a88d2df56d516fe7b1050663811b818da3d1
ARG IMPACT_PACK_REQUIREMENTS_SHA256=a8220b5c17eabc1edb99739679b65907cc17d8d4dd0980f73fe638989b4365a8
ARG VIDEO_HELPER_SUITE_REQUIREMENTS_SHA256=dbf7158d81418ace41097db503440bb70f41b6250d5d0b3ab3b3c86271b7b2a3
ARG KJNODES_REQUIREMENTS_SHA256=e8cc1fb089c6e74bb5f326e949fd89ea7653de0d193d7a385c38af44e66656bd
ARG RGTHREE_REQUIREMENTS_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
ARG ESSENTIALS_REQUIREMENTS_SHA256=075836eae22a6c13bf4be71e92397096994f3cf8d748038773c681319795bdc3
ARG CONTROLNET_AUX_REQUIREMENTS_SHA256=3ed811fd0028017752d455366feee1a22f055885a1cac5ffce837d6dea2a26a3
ARG CRYSTOOLS_REQUIREMENTS_SHA256=9ae8fae7f3f90337ede26e397fe83e4119ae2f14b1dace7cecc1d334ef31a982
ARG CCTECH_GGUF_LOADER_REQUIREMENTS_SHA256=0e6d4d04b65a1c8969917f9d32a13ac6dd09597932239c493469e0b49a6b97b0

RUN mkdir -p /opt/anvil \
    && printf '%s\n' \
      'torch==2.13.0' \
      'torchvision==0.28.0' \
      'torchaudio==2.11.0' \
      > /opt/anvil/comfy-core-constraints.txt

# The verified CUDA base supplies the Python/CUDA runtime only. Replace its
# older ComfyUI checkout with the exact upstream v0.35.2 source before nodes
# are installed, so the graph's LTX core APIs are actually present.
# Preserve the inherited launcher: the base image's CMD invokes it and it wires
# the preserved venv into ComfyUI.
RUN git clone https://github.com/Comfy-Org/ComfyUI.git /opt/anvil/comfy-source \
    && git -c safe.directory=/opt/anvil/comfy-source -C /opt/anvil/comfy-source checkout --detach "$COMFYUI_RELEASE_REV" \
    && find /app -mindepth 1 -maxdepth 1 ! -name venv ! -name docker-entrypoint.sh -exec rm -rf '{}' + \
    && cp -a /opt/anvil/comfy-source/. /app/ \
    && /app/venv/bin/python -m pip install -c /opt/anvil/comfy-core-constraints.txt -r /app/requirements.txt

COPY install-comfyui-node.sh /opt/anvil/install-comfyui-node.sh

RUN echo "${INSTALLER_SHA256}  /opt/anvil/install-comfyui-node.sh" | sha256sum --check --strict

RUN actual_revision="$(git -c safe.directory=/app -C /app rev-parse HEAD)" \
    && test "$actual_revision" = "$COMFYUI_RELEASE_REV" \
    || { echo "ComfyUI revision mismatch: expected $COMFYUI_RELEASE_REV, got $actual_revision" >&2; exit 1; }

RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh comfyui-manager https://github.com/Comfy-Org/ComfyUI-Manager.git "$COMFYUI_MANAGER_REV" "$COMFYUI_MANAGER_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI-VideoHelperSuite https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git "$VIDEO_HELPER_SUITE_REV" "$VIDEO_HELPER_SUITE_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI-KJNodes https://github.com/kijai/ComfyUI-KJNodes.git "$KJNODES_REV" "$KJNODES_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh rgthree-comfy https://github.com/rgthree/rgthree-comfy.git "$RGTHREE_REV" "$RGTHREE_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI_essentials https://github.com/cubiq/ComfyUI_essentials.git "$ESSENTIALS_REV" "$ESSENTIALS_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI-Crystools https://github.com/crystian/ComfyUI-Crystools.git "$CRYSTOOLS_REV" "$CRYSTOOLS_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI-GGUF-Loader https://github.com/ChrisColeTech/ComfyUI-GGUF-Loader.git "$CCTECH_GGUF_LOADER_REV" "$CCTECH_GGUF_LOADER_REQUIREMENTS_SHA256"

# The last two packs are deliberately isolated because their segmentation and
# preprocessing dependencies are much larger than the core workflow helpers.
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh ComfyUI-Impact-Pack https://github.com/ltdrdata/ComfyUI-Impact-Pack.git "$IMPACT_PACK_REV" "$IMPACT_PACK_REQUIREMENTS_SHA256"
RUN --mount=type=cache,target=/root/.cache/pip \
    sh /opt/anvil/install-comfyui-node.sh comfyui_controlnet_aux https://github.com/Fannovel16/comfyui_controlnet_aux.git "$CONTROLNET_AUX_REV" "$CONTROLNET_AUX_REQUIREMENTS_SHA256"

RUN /app/venv/bin/python -m pip uninstall --yes pynvml \
    && /app/venv/bin/python -c "import pynvml" \
    && /app/venv/bin/python -c \
      "import torch, torchvision, torchaudio; assert torch.__version__ == '2.13.0+cu130'; assert torchvision.__version__ == '0.28.0+cu130'; assert torchaudio.__version__ == '2.11.0+cu130'" \
    && chown -R 1000:1000 /app/custom_nodes /app/venv \
    && find /app/custom_nodes -mindepth 1 -maxdepth 1 -type d -exec test -d '{}/.git' ';' \
    && test -x /app/docker-entrypoint.sh \
    && test -f /app/main.py \
    && mkdir -p /app/input /app/output /app/temp /app/user \
    && chown 1000:1000 /app/input /app/output /app/temp /app/user \
    && for writable_dir in /app/input /app/output /app/temp /app/user; do test "$(stat -c %u:%g "$writable_dir")" = 1000:1000; done \
    && test -x /app/venv/bin/python \
    && test "${VIRTUAL_ENV}" = /app/venv \
    && test "${VIRTUAL_ENV_CUSTOM}" = /app/custom_venv \
    && command -v rsync >/dev/null \
    && command -v find >/dev/null \
    && command -v sort >/dev/null \
    && command -v comm >/dev/null \
    && command -v sed >/dev/null \
    && /bin/sh -n /app/docker-entrypoint.sh

LABEL org.opencontainers.image.title="Anvil ComfyUI curated add-ons" \
      org.opencontainers.image.description="ComfyUI 0.35.2 with headless GLSL dependencies and pinned, curated custom nodes" \
      org.opencontainers.image.base.digest="sha256:c7bef1de5e5a611a446a2b7f8a3483cf8e870cfbb4ec38cdfa6de2b9b5c14da0" \
      org.opencontainers.image.base.manifest.digest="sha256:0141d3fb099318e0079479a6ee445e32ed18f2400d1a8f10aa5dc0b62a78a1ad" \
      org.opencontainers.image.comfyui.release="v0.35.2" \
      org.opencontainers.image.comfyui.release.revision="${COMFYUI_RELEASE_REV}" \
      org.opencontainers.image.comfyui.image.revision="${COMFYUI_IMAGE_REV}"

USER 1000:1000

# Prove the runtime identity can write every ComfyUI mutable directory before
# a mounted operator volume changes those paths at container start.
RUN set -eu; for writable_dir in /app/input /app/output /app/temp /app/user; do \
      test -d "$writable_dir"; \
      probe="$writable_dir/.anvil-write-probe"; \
      : > "$probe"; \
      rm -f "$probe"; \
    done; \
    rmdir /app/temp || test -d /app/temp; \
    mkdir -p /app/temp
