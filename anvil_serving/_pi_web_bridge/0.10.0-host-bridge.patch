index 0000000..67f0a97
--- /dev/null
+++ b/app/api/mobile-pi/[...path]/route.ts
@@ -0,0 +1,57 @@
+import { GET as sessions } from "@/app/api/sessions/route";
+import { GET as detail } from "@/app/api/sessions/[id]/route";
+import { GET as context } from "@/app/api/sessions/[id]/context/route";
+import { GET as state } from "@/app/api/sessions/[id]/state/route";
+import { POST as command } from "@/app/api/agent/[id]/route";
+import { createAgentEventStream } from "@/lib/agent-event-stream";
+import { getRpcSession, startRpcSession } from "@/lib/rpc-manager";
+import { resolveSessionPath } from "@/lib/session-reader";
+import { createMobilePiHandler } from "@/lib/mobile-pi-api";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+
+const handle = createMobilePiHandler({
+  async read(kind, req, id) {
+    if (kind === "sessions") return sessions(req);
+    const params = { params: Promise.resolve({ id: id! }) };
+    if (kind === "detail") return detail(req, params);
+    if (kind === "context") return context(req, params);
+    if (kind === "state") return state(req, params);
+    if (req.signal.aborted) return new Response(null, { status: 204 });
+    let session = getRpcSession(id!);
+    if (!session?.isAlive()) {
+      const filePath = await resolveSessionPath(id!);
+      if (!filePath) return Response.json({ error: "not found" }, { status: 404 });
+      // Await startup here so native SSE cannot publish a raw startup exception.
+      session = (await startRpcSession(id!, filePath, undefined)).session;
+    }
+    const ownerSession = session;
+    const stream = createAgentEventStream(req, id!, Promise.resolve({
+      get isStreaming() { return ownerSession.isStreaming; },
+      get streamingMessage() { return ownerSession.streamingMessage; },
+      isAlive: () => ownerSession.isAlive(),
+      onEvent(listener) {
+        try {
+          return ownerSession.onEvent(event => listener(event.type === "prompt_error"
+            ? { type: "prompt_error", errorMessage: "Agent request failed" }
+            : event.type === "extension_error"
+              ? { type: "extension_error", error: "Extension request failed" }
+              : event));
+        } catch { throw new Error("Agent event stream unavailable"); }
+      },
+    }));
+    return new Response(stream, { headers: {
+      "Content-Type": "text/event-stream", "Cache-Control": "no-cache, no-transform",
+      Connection: "keep-alive", "X-Accel-Buffering": "no",
+    } });
+  },
+  async command(id, body) {
+    return command(new Request("http://127.0.0.1/api/agent/" + encodeURIComponent(id), {
+      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
+    }), { params: Promise.resolve({ id }) });
+  },
+});
+
+export async function GET(req: Request) { return handle(req); }
+export async function POST(req: Request) { return handle(req); }
