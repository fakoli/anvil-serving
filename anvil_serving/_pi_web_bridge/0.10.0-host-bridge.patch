+    } catch { return error(503); }
+  };
+
+  return async (req: Request): Promise<Response> => {
+    if (!mobilePiAuthorized(req.headers.get("authorization"), token())) return error(404);
+    const url = new URL(req.url);
+    const route = /^\/api\/mobile-pi\/sessions(?:\/([^/]+)(?:\/(context|state|events|command))?)?$/.exec(url.pathname);
+    if (!route) return error(404);
+    let id: string | undefined;
+    try { id = route[1] ? decodeURIComponent(route[1]) : undefined; } catch { return error(400); }
+    if (id !== undefined && !safeId(id)) return error(400);
+    const kind = !id ? "sessions" : route[2] ?? "detail";
