+    }
+    if(data.action === "abort" && exact(data,[...minimal,"pendingRequests"])) {
+      if(!Array.isArray(data.pendingRequests) || data.pendingRequests.length > 128 || data.pendingRequests.some(x=>typeof x !== "string" || !UUID.test(x))) return fail();
+      if(cancelled.size + data.pendingRequests.length > 100000) return fail(503);
