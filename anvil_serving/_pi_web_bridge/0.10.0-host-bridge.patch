index e69de29..7e740fb 100644
--- a/lib/propagation-observer-auth.ts
+++ b/lib/propagation-observer-auth.ts
@@ -0,0 +1,28 @@
+import { timingSafeEqual } from "node:crypto";
+
+const OBSERVER_TOKEN = /^[A-Za-z0-9_-]{32,256}$/;
+
+function authorizedToken(value: string | null, candidate: string | undefined): boolean {
+  if (!candidate || !OBSERVER_TOKEN.test(candidate) || !value || !value.startsWith("Bearer ")) return false;
+  const supplied = Buffer.from(value.slice(7));
+  const expected = Buffer.from(candidate);
+  return supplied.length === expected.length && timingSafeEqual(supplied, expected);
+}
+
+export function propagationObserverAuthorized(value: string | null): boolean {
+  const observer = process.env.PI_WEB_PROPAGATION_OBSERVER_TOKEN;
+  const bridge = process.env.PI_WEB_WORKBENCH_BRIDGE_TOKEN;
+  const password = process.env.PI_WEB_PASSWORD;
+  return Boolean(observer && observer !== bridge && observer !== password
+    && observer !== process.env.PI_WEB_PROPAGATION_ACCEPTANCE_TOKEN
+    && authorizedToken(value, observer));
+}
+
+export function propagationAcceptanceAuthorized(value: string | null): boolean {
+  const acceptance = process.env.PI_WEB_PROPAGATION_ACCEPTANCE_TOKEN;
+  const observer = process.env.PI_WEB_PROPAGATION_OBSERVER_TOKEN;
+  const bridge = process.env.PI_WEB_WORKBENCH_BRIDGE_TOKEN;
+  const password = process.env.PI_WEB_PASSWORD;
+  return Boolean(acceptance && acceptance !== observer && acceptance !== bridge && acceptance !== password
+    && authorizedToken(value, acceptance));
+}
