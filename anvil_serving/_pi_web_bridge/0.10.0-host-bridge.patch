diff --git a/lib/workbench-bridge.ts b/b/lib/workbench-bridge.ts
index e69de29..e840d8f 100644
--- a/lib/workbench-bridge.ts
+++ b/lib/workbench-bridge.ts
@@ -0,0 +1,106 @@
+import { timingSafeEqual } from "crypto";
+import { existsSync, mkdirSync, readFileSync } from "fs";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { isAbsolute, join, resolve } from "path";
+import { writePrivateFileAtomicSync } from "./atomic-file";
+import { getRpcSession, getRpcSessionInfos, startRpcSession } from "./rpc-manager";
+import { getAgentDir, listAllSessions, mergeSessionLists, resolveSessionPath } from "./session-reader";
+
+type Reservation = { project_id: string; session_id: string };
+type Registry = { version: 1; reservations: Record<string, Reservation> };
+
+const KEY = /^[a-f0-9]{64}$/;
+const ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$/;
+const PROJECT = /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$/;
+const MAX_CWD_BYTES = 4096;
+
+function exactKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
+  return Object.keys(value).length === keys.length && keys.every((key) => Object.hasOwn(value, key));
+}
+
+function registryPath(): string {
+  return join(getAgentDir(), "workbench-host-bridge.json");
+}
+
+function load(): Registry {
+  const path = registryPath();
+  if (!existsSync(path)) return { version: 1, reservations: {} };
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(path, "utf8"));
+    if (!parsed || typeof parsed !== "object") throw new Error();
+    const registry = parsed as Registry;
+    if (registry.version !== 1 || !registry.reservations || typeof registry.reservations !== "object" || Array.isArray(registry.reservations) || !exactKeys(registry as unknown as Record<string, unknown>, ["version", "reservations"])) throw new Error();
+    for (const [key, row] of Object.entries(registry.reservations)) {
+      if (!KEY.test(key) || !row || typeof row !== "object" || Array.isArray(row) || !exactKeys(row as Record<string, unknown>, ["project_id", "session_id"]) || !PROJECT.test(row.project_id) || !ID.test(row.session_id)) throw new Error();
+    }
+    return registry;
+  } catch {
+    throw new Error("host bridge registry unavailable");
+  }
+}
+
+function save(registry: Registry): void {
+  mkdirSync(getAgentDir(), { recursive: true, mode: 0o700 });
+  writePrivateFileAtomicSync(registryPath(), JSON.stringify(registry));
+}
+
+function nativeId(requestKey: string): string {
+  return `workbench-${requestKey}`;
+}
+
+export function bridgeAuthorized(value: string | null): boolean {
+  const token = process.env.PI_WEB_WORKBENCH_BRIDGE_TOKEN;
+  if (!token || !value || !value.startsWith("Bearer ")) return false;
+  const supplied = Buffer.from(value.slice(7));
+  const expected = Buffer.from(token);
+  return supplied.length === expected.length && timingSafeEqual(supplied, expected);
+}
+
+export async function ensureWorkbenchSession(value: unknown): Promise<{ session_id: string }> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("invalid request");
+  const body = value as Record<string, unknown>;
+  if (!exactKeys(body, ["v", "request_key", "project_id", "cwd"]) || body.v !== 1 || typeof body.request_key !== "string" || !KEY.test(body.request_key) || typeof body.project_id !== "string" || !PROJECT.test(body.project_id) || typeof body.cwd !== "string" || !isAbsolute(body.cwd) || Buffer.byteLength(body.cwd, "utf8") > MAX_CWD_BYTES) throw new Error("invalid request");
+  const registry = load();
+  const prior = registry.reservations[body.request_key];
+  if (prior && prior.project_id !== body.project_id) throw new Error("request conflict");
+  const session_id = prior?.session_id ?? nativeId(body.request_key);
+  if (!prior) {
+    registry.reservations[body.request_key] = { project_id: body.project_id, session_id };
+    save(registry);
+  }
+  if (!getRpcSession(session_id)?.isAlive()) {
+    const path = await resolveSessionPath(session_id);
+    await startRpcSession(session_id, path ?? "", body.cwd, { sessionId: session_id });
+  }
+  return { session_id };
+}
+
+function sameCwd(first: string, second: string): boolean {
+  return resolve(first) === resolve(second);
+}
+
+export async function associateWorkbenchSession(value: unknown): Promise<{ session_id: string }> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("invalid request");
+  const body = value as Record<string, unknown>;
+  if (!exactKeys(body, ["v", "request_key", "project_id", "cwd", "native_id"]) || body.v !== 1 || typeof body.request_key !== "string" || !KEY.test(body.request_key) || typeof body.project_id !== "string" || !PROJECT.test(body.project_id) || typeof body.cwd !== "string" || !isAbsolute(body.cwd) || Buffer.byteLength(body.cwd, "utf8") > MAX_CWD_BYTES || typeof body.native_id !== "string" || !ID.test(body.native_id)) throw new Error("invalid request");
+  const path = await resolveSessionPath(body.native_id);
+  if (!path || !sameCwd(SessionManager.open(path).getCwd(), body.cwd)) throw new Error("native session is outside the declared root");
+  const registry = load();
+  const prior = registry.reservations[body.request_key];
+  if (prior && (prior.project_id !== body.project_id || prior.session_id !== body.native_id)) throw new Error("request conflict");
+  if (!prior) {
+    registry.reservations[body.request_key] = { project_id: body.project_id, session_id: body.native_id };
+    save(registry);
+  }
+  return { session_id: body.native_id };
+}
+
+export async function listWorkbenchSessions(): Promise<{ native_id: string; title: string; running: boolean }[]> {
+  const sessions = mergeSessionLists(await listAllSessions(), getRpcSessionInfos());
+  if (sessions.length > 512) throw new Error("native session inventory exceeds the declared bridge limit");
+  return sessions.map((session) => ({
+    native_id: session.id,
+    title: (session.name || "Untitled session").slice(0, 192),
+    running: Boolean(getRpcSession(session.id)?.isRunning()),
+  }));
+}
