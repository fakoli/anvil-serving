+  return {ownerInstance:instance,revision,commands};
+}
+function heartbeat(response: Response, req: Request): Response {
+  const reader = response.body?.getReader(); if(!reader) return fail(503);
+  const encoder = new TextEncoder(); let timer: ReturnType<typeof setInterval>;
+  const stream = new ReadableStream<Uint8Array>({
+    start(controller) {
+      timer = setInterval(() => { try { controller.enqueue(encoder.encode(": heartbeat\n\n")); } catch {} },1000);
