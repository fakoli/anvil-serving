+import { createHash, randomUUID } from "node:crypto";
+import { lstatSync, realpathSync, statSync } from "node:fs";
+import { isAbsolute } from "node:path";
+import { nativeAgentsOwnerAuthorized } from "./native-agents-owner-auth";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { getRpcSession, getRpcSessionInfos, startRpcSession } from "./rpc-manager";
+import { listAllSessions, mergeSessionLists, resolveSessionPath } from "./session-reader";
+import { GET as historyGET } from "../app/api/sessions/[id]/route";
+import { GET as contextGET } from "../app/api/sessions/[id]/context/route";
+import { GET as eventsGET } from "../app/api/agent/[id]/events/route";
+
+const ID = /^[A-Za-z0-9][A-Za-z0-9_-]{0,159}$/;
+const UUID = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
+const instance = randomUUID();
+const cancelled = new Map<string,string>();
+type Operation = {requestID:string;sessionID:string;state:"dispatched"|"accepted"|"rejected";digest:string};
+const operations = new Map<string,Operation>();
+function enqueue(sessionID:string, requestID:string, input:unknown, execute:()=>Promise<unknown>): Response {
+  const digest = createHash("sha256").update(JSON.stringify([sessionID,input])).digest("hex");
+  const old = operations.get(requestID);
+  if(old) return old.digest === digest ? json({requestID,sessionID,state:old.state}) : fail(409);
+  if(operations.size >= 2048) {
+    for(const [id,row] of operations) { if(row.state !== "dispatched") { operations.delete(id); break; } }
+  }
+  if(operations.size >= 2048) return fail(503);
+  const operation:Operation = {requestID,sessionID,digest,state:"dispatched"}; operations.set(requestID,operation);
+  void Promise.resolve().then(()=>{ if(cancelled.get(requestID) === sessionID) throw new Error("cancelled"); return execute(); })
+    .then(()=>{operation.state="accepted";},()=>{operation.state="rejected";});
+  return json({requestID,sessionID,state:"dispatched"},202);
+}
+const json = (body: unknown, status = 200) => Response.json(body, {status, headers:{"Cache-Control":"no-store"}});
+const fail = (status = 400) => json({error:"invalid request"}, status);
+function exact(body: Record<string, unknown>, keys: string[]) {
+  return Object.keys(body).length === keys.length && keys.every(k => Object.hasOwn(body, k));
+}
+function text(value: unknown, max: number) { return typeof value === "string" && Buffer.byteLength(value) <= max && !value.includes("\0"); }
+async function body(req: Request): Promise<Record<string, unknown> | null> {
+  if (req.headers.get("content-type")?.split(";",1)[0].trim() !== "application/json" || !req.body) return null;
+  const reader = req.body.getReader(); let size = 0; const parts: Uint8Array[] = [];
+  try { while(true) { const next = await reader.read(); if(next.done) break; size += next.value.byteLength;
+    if(size > 65536) { await reader.cancel(); return null; } parts.push(next.value); }
+    const value: unknown = JSON.parse(Buffer.concat(parts).toString("utf8"));
+    return value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : null;
+  } catch { return null; } finally { reader.releaseLock(); }
+}
+function allowedDirectory(cwd: unknown): cwd is string {
+  if (!text(cwd,4096) || !isAbsolute(cwd as string)) return false;
+  try {
+    const roots: unknown = JSON.parse(process.env.PI_WEB_NATIVE_AGENTS_DIRECTORIES ?? "[]");
+    return Array.isArray(roots) && roots.includes(cwd) && realpathSync(cwd as string) === cwd && statSync(cwd as string).isDirectory();
+  } catch { return false; }
+}
+async function persistedSessionPath(id: string): Promise<string | null> {
+  const path = await resolveSessionPath(id);
+  if(!path) return null;
+  // Pi caches the future session filename before its first persisted turn.
+  // Once its idle wrapper closes, that cache entry is not a saved session.
+  // Never let SessionManager.open(missing) silently choose process.cwd().
+  try {
+    if(!lstatSync(path).isFile()) throw new Error("session file is not regular");
+    return path;
+  } catch(error) {
+    if((error as NodeJS.ErrnoException).code === "ENOENT") return null;
+    throw error;
+  }
+}
+async function session(id: string) {
+  const existing = getRpcSession(id);
+  if(existing?.isAlive()) return existing;
+  const path = await persistedSessionPath(id);
+  if(!path) return undefined;
+  return (await startRpcSession(id,path,undefined)).session;
+}
+function interactions(owner: NonNullable<ReturnType<typeof getRpcSession>>) {
+  const items: Record<string, unknown>[] = [];
+  const unsubscribe = owner.onEvent(event => {
+    if(event.type !== "extension_ui_request" || typeof event.id !== "string" || !ID.test(event.id)) return;
+    const method = event.method;
+    if(!["select","confirm","input","editor","custom"].includes(method as string) || event.closed === true) return;
+    const item: Record<string, unknown> = {id:event.id,method,title:typeof event.title === "string" ? event.title.slice(0,1024) : "Pi interaction",supported:method !== "custom"};
+    for(const key of ["message","placeholder","prefill"]) if(typeof event[key] === "string") item[key] = (event[key] as string).slice(0,32768);
+    if(Array.isArray(event.options) && event.options.length <= 128 && event.options.every(o => text(o,2048))) item.options = event.options;
+    else if(method === "select") item.supported = false;
+    if(typeof event.expiresAt === "number") item.expiresAt = event.expiresAt / 1000;
+    if(item.expiresAt === undefined || (item.expiresAt as number) > Date.now()/1000) items.push(item);
+  }); unsubscribe();
+  return items.slice(0,128);
+}
+function validAnswer(item: Record<string,unknown>, answer: Record<string,unknown>) {
+  if(exact(answer,["cancelled"]) && answer.cancelled === true) return item.method !== "custom";
+  if(item.supported !== true) return false;
+  if(item.method === "confirm") return exact(answer,["confirmed"]) && typeof answer.confirmed === "boolean";
+  if(!exact(answer,["value"]) || !text(answer.value,32768)) return false;
+  return item.method !== "select" || (Array.isArray(item.options) && item.options.includes(answer.value));
+}
+async function catalog(owner: NonNullable<ReturnType<typeof getRpcSession>>) {
+  const result = await owner.send({type:"get_commands"}) as {commands: Record<string,unknown>[]};
+  if(!Array.isArray(result.commands) || result.commands.length > 512) throw new Error("catalog unavailable");
+  const seen = new Set<string>();
+  const commands = result.commands.filter(c => typeof c.name === "string" && !seen.has(c.name) && Boolean(seen.add(c.name))).filter(c => typeof c.name === "string" && /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$/.test(c.name) && ["extension","prompt","skill"].includes(c.source as string)).map(c => ({
+    id:createHash("sha256").update(JSON.stringify([c.source,c.name])).digest("hex"),name:c.name,
+    description:typeof c.description === "string" ? c.description.slice(0,2048):"",source:c.source,supported:true
+  }));
