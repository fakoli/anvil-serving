+          && Buffer.byteLength(body.message) <= MAX_TEXT_BYTES) command = { type: "prompt", message: body.message };
+      else if (body.type === "abort" && !Object.hasOwn(body, "message")) command = { type: "abort" };
+      else return error(400);
+      if (body.requestId === undefined) return dispatch(id, command);
+      const key = body.requestId.toLowerCase();
+      const digest = createHash("sha256").update(JSON.stringify([id, command])).digest("hex");
+      for (const [receiptId, receipt] of receipts) {
+        if (receipt.settledAt !== null && Date.now() - receipt.settledAt >= RECEIPT_TTL_MS) receipts.delete(receiptId);
+      }
+      const prior = receipts.get(key);
+      if (prior) return prior.digest === digest ? (await prior.response).clone() : error(409);
+      // Never evict an in-flight receipt or silently admit without a receipt.
+      if (receipts.size >= MAX_RECEIPTS) return error(503);
+      const receipt: Receipt = { digest, settledAt: null, response: Promise.resolve(error(503)) };
+      receipts.set(key, receipt);
+      receipt.response = dispatch(id, command).then(response => { receipt.settledAt = Date.now(); return response; });
+      return (await receipt.response).clone();
+    }
+    if (req.method !== "GET" || kind === "command") return error(404);
+    const allowed: Record<string, Record<string, string | null>> = {
+      sessions: { summary: "1" },
+      detail: { force: "1", tail: "50", tree: "summary", deferThinking: "1", deferMedia: "1" },
+      context: { before: null, tail: "50" }, state: {}, events: {},
+    };
+    const query = allowed[kind];
+    for (const [name, value] of url.searchParams) {
+      if (!Object.hasOwn(query, name) || url.searchParams.getAll(name).length !== 1
+          || (query[name] === null ? !SAFE_ID.test(value) : value !== query[name])) return error(400);
+    }
+    const target = new URL(req.url);
+    target.search = "";
+    if (kind === "sessions") target.searchParams.set("summary", "1");
+    if (kind === "detail") {
+      for (const [key, value] of Object.entries(allowed.detail)) target.searchParams.set(key, value!);
+    }
+    if (kind === "context") {
+      const before = url.searchParams.get("before");
+      if (before) target.searchParams.set("before", before);
+      target.searchParams.set("tail", "50");
+      target.searchParams.set("deferThinking", "1");
+      target.searchParams.set("deferMedia", "1");
+    }
+    // Same owner handlers and globals as the native UI; no new runtime or session authority.
+    try {
+      const response = await owner.read(kind as "sessions" | "detail" | "context" | "state" | "events", new Request(target, req), id);
+      if (response.status >= 400) return error(response.status);
+      response.headers.set("Cache-Control", kind === "events" ? "no-cache, no-transform" : "no-store");
+      return response;
+    } catch { return error(503); }
+  };
+}
