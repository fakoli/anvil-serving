--- a/app/api/propagation/session-state/route.ts
+++ b/app/api/propagation/session-state/route.ts
@@ -0,0 +1,20 @@
+import { NextResponse } from "next/server";
+import {
+  observePropagationSession,
+  validPropagationNativeId,
+} from "@/lib/propagation-observer";
+import { propagationObserverAuthorized } from "@/lib/propagation-observer-auth";
+
+export const runtime = "nodejs";
+
+export function GET(request: Request) {
+  if (!propagationObserverAuthorized(request.headers.get("authorization"))) {
+    return NextResponse.json({ error: "not found" }, { status: 404, headers: { "Cache-Control": "no-store" } });
+  }
+  const search = new URL(request.url).searchParams;
+  const nativeId = search.get("id");
+  if (search.size !== 1 || !validPropagationNativeId(nativeId)) {
+    return NextResponse.json({ error: "not found" }, { status: 404, headers: { "Cache-Control": "no-store" } });
+  }
+  return NextResponse.json(observePropagationSession(nativeId), { headers: { "Cache-Control": "no-store" } });
+}
