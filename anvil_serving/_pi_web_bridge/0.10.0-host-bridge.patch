+import { createHash, timingSafeEqual } from "node:crypto";
+
+const SAFE_ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$/;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_BODY_BYTES = 64 * 1024;
+const MAX_TEXT_BYTES = 32 * 1024;
+const MAX_RECEIPTS = 2048;
+const RECEIPT_TTL_MS = 24 * 60 * 60 * 1000;
+
+export function mobilePiAuthorized(value: string | null, token = process.env.PI_WEB_WORKBENCH_BRIDGE_TOKEN): boolean {
+  if (!token || !value?.startsWith("Bearer ")) return false;
+  const actual = Buffer.from(value.slice(7));
+  const expected = Buffer.from(token);
+  return actual.length === expected.length && timingSafeEqual(actual, expected);
+}
+
+export type MobileCommand = { type: "prompt"; message: string } | { type: "abort" };
+export interface MobilePiOwner {
+  read(kind: "sessions" | "detail" | "context" | "state" | "events", req: Request, id?: string): Promise<Response>;
+  command(id: string, command: MobileCommand): Promise<Response>;
+}
+type Receipt = { digest: string; settledAt: number | null; response: Promise<Response> };
