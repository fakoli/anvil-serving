+      void (async () => { try { while(true) { const next = await reader.read(); if(next.done) break; controller.enqueue(next.value); } controller.close(); }
+        catch(error) { controller.error(error); } finally { clearInterval(timer); req.signal.removeEventListener("abort",cancel); reader.releaseLock(); } })();
+    }, cancel() { clearInterval(timer); void reader.cancel(); }
+  });
