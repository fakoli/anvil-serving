+      if(data.before !== null && (typeof data.before !== "string" || !ID.test(data.before))) return fail();
+      const path = await persistedSessionPath(id);
+      if(!path) {
+        return json({context:{messages:[],hasMore:false,entryIds:[]}});
+      }
+      const target = new URL(req.url); target.search = "tail=50&deferThinking=1&deferMedia=1";
+      if(data.before) target.searchParams.set("before",data.before as string);
+      else { target.searchParams.set("force","1"); target.searchParams.set("tree","summary"); }
+      const read = new Request(target,{method:"GET",headers:{Accept:"application/json"},signal:req.signal});
+      return data.before ? contextGET(read,{params:Promise.resolve({id})}) : historyGET(read,{params:Promise.resolve({id})});
+    }
+    if(data.action === "events" && exact(data,minimal)) return heartbeat(await eventsGET(req,{params:Promise.resolve({id})}),req);
+    return fail();
+  } catch { return fail(503); }
+}
