+}
+export async function nativeAgentsOwner(req: Request): Promise<Response> {
+  if (!nativeAgentsOwnerAuthorized(req.headers.get("authorization"))) return fail(404);
+  const url = new URL(req.url); if(url.search || req.method !== "POST") return fail(404);
+  const data = await body(req); if(!data || typeof data.action !== "string") return fail();
+  try {
+    if(data.action === "sessions" && exact(data,["action"])) {
+      const rows = mergeSessionLists(await listAllSessions(),getRpcSessionInfos({includeTransient:true}));
+      if(rows.length > 512) return fail(503);
+      return json({sessions:rows.map(s=>({id:s.id,title:s.name || "Untitled session",messageCount:0,isRunning:Boolean(getRpcSession(s.id)?.isRunning())}))});
+    }
+    if(typeof data.sessionID !== "string" || !ID.test(data.sessionID)) return fail();
+    const id = data.sessionID;
+    if(data.action === "ensure" && exact(data,["action","sessionID","cwd"])) {
+      if(!allowedDirectory(data.cwd) || !/^native-[a-f0-9]{64}$/.test(id)) return fail();
+      const existing = getRpcSession(id);
+      if(existing?.isAlive()) {
+        if(existing.cwd !== data.cwd) return fail(409);
+      } else {
+        const path = await persistedSessionPath(id);
+        if(path && SessionManager.open(path).getCwd() !== data.cwd) return fail(409);
+        await startRpcSession(id,path ?? "",data.cwd,{sessionId:id});
+      }
+      return json({sessionID:id});
+    }
+    const owner = await session(id); if(!owner) return fail(404);
+    const minimal = ["action","sessionID"];
+    if(data.action === "operation" && exact(data,[...minimal,"requestID"])) {
+      if(typeof data.requestID !== "string") return fail();
+      const op = operations.get(data.requestID);
+      if(!op || op.sessionID !== id) return fail(404);
+      return json({requestID:op.requestID,sessionID:op.sessionID,state:op.state});
+    }
+    if(data.action === "state" && exact(data,minimal)) {
+      const state = await owner.send({type:"get_state"}) as Record<string,unknown>;
+      return json({running:true,state:{isStreaming:state.isStreaming,isPromptRunning:state.isPromptRunning,isBashRunning:state.isBashRunning,isCompacting:state.isCompacting}});
+    }
+    if(data.action === "catalog" && exact(data,minimal)) return json(await catalog(owner));
+    if(data.action === "interactions" && exact(data,minimal)) return json({ownerInstance:instance,interactions:interactions(owner)});
+    if(data.action === "invoke" && exact(data,[...minimal,"requestID","ownerInstance","message"])) {
+      if(typeof data.requestID !== "string" || !UUID.test(data.requestID) || data.ownerInstance !== instance || !text(data.message,32768) || !(data.message as string).trim()) return fail(409);
+      if(cancelled.get(data.requestID) === id) return fail(409);
+      return enqueue(id,data.requestID,data,()=>owner.send({type:"prompt",message:data.message}));
+    }
+    if(data.action === "invoke_command" && exact(data,[...minimal,"requestID","ownerInstance","commandID","catalogRevision","arguments"])) {
+      if(typeof data.requestID !== "string" || !UUID.test(data.requestID) || data.ownerInstance !== instance || !text(data.arguments,32768)) return fail(409);
+      const current = await catalog(owner);
