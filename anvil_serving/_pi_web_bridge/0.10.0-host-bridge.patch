diff --git a/app/api/propagation/session-acceptance/route.ts b/b/app/api/propagation/session-acceptance/route.ts
index e69de29..c9a3230 100644
--- a/app/api/propagation/session-acceptance/route.ts
+++ b/app/api/propagation/session-acceptance/route.ts
@@ -0,0 +1,18 @@
+import { NextResponse } from "next/server";
+import { runPropagationAcceptance } from "@/lib/propagation-acceptance";
+import { propagationAcceptanceAuthorized } from "@/lib/propagation-observer-auth";
+
+export const runtime = "nodejs";
+
+export async function POST(request: Request) {
+  if (!propagationAcceptanceAuthorized(request.headers.get("authorization"))) {
+    return NextResponse.json({ error: "not found" }, { status: 404, headers: { "Cache-Control": "no-store" } });
+  }
+  try {
+    return NextResponse.json(await runPropagationAcceptance(await request.json()), {
+      headers: { "Cache-Control": "no-store" },
+    });
+  } catch {
+    return NextResponse.json({ error: "unavailable" }, { status: 409, headers: { "Cache-Control": "no-store" } });
+  }
+}
