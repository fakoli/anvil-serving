+import { NextResponse } from "next/server";
+import { associateWorkbenchSession, bridgeAuthorized } from "@/lib/workbench-bridge";
+
+export async function POST(request: Request) {
+  if (!bridgeAuthorized(request.headers.get("authorization"))) return NextResponse.json({ error: "not found" }, { status: 404 });
+  try { return NextResponse.json({ v: 1, ...(await associateWorkbenchSession(await request.json())) }); }
+  catch { return NextResponse.json({ error: "unavailable" }, { status: 409 }); }
+}
