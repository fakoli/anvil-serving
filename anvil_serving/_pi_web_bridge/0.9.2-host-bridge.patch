diff --git a/lib/propagation-acceptance.ts b/lib/propagation-acceptance.ts
new file mode 100644
index 0000000..de24987
--- /dev/null
+++ b/lib/propagation-acceptance.ts
@@ -0,0 +1,400 @@
+import { randomUUID } from "node:crypto";
+import {
+  closeSync,
+  fsyncSync,
+  lstatSync,
+  mkdirSync,
+  openSync,
+  unlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { join } from "node:path";
+import { getRpcSession, startRpcSession, type AgentEvent, type AgentSessionWrapper } from "./rpc-manager";
+import { observePropagationSession } from "./propagation-observer";
+import { getAgentDir } from "./session-reader";
+
+const ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$/;
+const FIXTURE_ID = /^propagation-[A-Za-z0-9][A-Za-z0-9._-]{0,179}$/;
+const MAX_EVENTS = 8192;
+const TURN_TIMEOUT_MS = 120_000;
+
+type PreparedFixture = {
+  nativeId: string;
+  processGeneration: string;
+  historyMarker: string;
+  messageCount: number;
+  preparedAt: string;
+  session?: AgentSessionWrapper;
+  cancelled: Promise<void>;
+  cancel: () => void;
+  inFlight: Promise<void>;
+  finishFlight: () => void;
+  busy: boolean;
+};
+
+declare global {
+  var __anvilPropagationFixtures: Map<string, PreparedFixture> | undefined;
+  var __anvilPropagationCancellations: Map<string, string> | undefined;
+  var __anvilPropagationClosedCancellations: Map<string, string> | undefined;
+}
+
+function registry(): Map<string, PreparedFixture> {
+  return globalThis.__anvilPropagationFixtures ??= new Map();
+}
+
+function cancellations(): Map<string, string> {
+  return globalThis.__anvilPropagationCancellations ??= new Map();
+}
+
+function closedCancellations(): Map<string, string> {
+  return globalThis.__anvilPropagationClosedCancellations ??= new Map();
+}
+
+function requireNotCancelled(operationId: string, nativeId: string): void {
+  const cancelledNativeId = cancellations().get(operationId);
+  if (cancelledNativeId !== undefined) {
+    if (cancelledNativeId !== nativeId) throw new Error("fixture identity conflict");
+    throw new Error("fixture cancelled");
+  }
+}
+
+function deferred(): { promise: Promise<void>; resolve: () => void } {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+function reserveOperation(operationId: string, nativeId: string): PreparedFixture {
+  requireNotCancelled(operationId, nativeId);
+  if (registry().has(operationId)
+      || [...registry().values()].some((fixture) => fixture.nativeId === nativeId)
+      || getRpcSession(nativeId)?.isAlive()) throw new Error("fixture conflict");
+  const cancellation = deferred();
+  const flight = deferred();
+  const fixture: PreparedFixture = {
+    nativeId,
+    processGeneration: "",
+    historyMarker: "",
+    messageCount: 0,
+    preparedAt: "",
+    cancelled: cancellation.promise,
+    cancel: cancellation.resolve,
+    inFlight: flight.promise,
+    finishFlight: flight.resolve,
+    busy: true,
+  };
+  registry().set(operationId, fixture);
+  return fixture;
+}
+
+function beginFlight(fixture: PreparedFixture): void {
+  if (fixture.busy) throw new Error("fixture operation is already running");
+  const flight = deferred();
+  fixture.inFlight = flight.promise;
+  fixture.finishFlight = flight.resolve;
+  fixture.busy = true;
+}
+
+function endFlight(fixture: PreparedFixture): void {
+  fixture.busy = false;
+  fixture.finishFlight();
+}
+
+function exactKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
+  return Object.keys(value).length === keys.length && keys.every((key) => Object.hasOwn(value, key));
+}
+
+function utcSeconds(): string {
+  return new Date().toISOString().replace(/\.\d{3}Z$/, "Z");
+}
+
+function fixtureRoot(): string {
+  const root = join(getAgentDir(), "propagation-fixtures");
+  mkdirSync(root, { recursive: true, mode: 0o700 });
+  const details = lstatSync(root);
+  if (!details.isDirectory() || details.isSymbolicLink() || (details.mode & 0o077) !== 0) {
+    throw new Error("fixture root is not private");
+  }
+  return root;
+}
+
+function fixtureId(value: unknown): string {
+  if (typeof value !== "string" || !FIXTURE_ID.test(value)) throw new Error("invalid fixture id");
+  return value;
+}
+
+function request(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("invalid request");
+  const body = value as Record<string, unknown>;
+  if (body.v !== 1 || typeof body.action !== "string" || typeof body.operation_id !== "string"
+      || !ID.test(body.operation_id)) throw new Error("invalid request");
+  return body;
+}
+
+async function sessionState(session: AgentSessionWrapper) {
+  const state = await session.send({ type: "get_state" });
+  if (!state || typeof state !== "object" || Array.isArray(state)) throw new Error("state unavailable");
+  const row = state as Record<string, unknown>;
+  if (row.sessionId !== session.sessionId || row.isStreaming !== false
+      || !Number.isSafeInteger(row.messageCount) || (row.messageCount as number) < 0) {
+    throw new Error("state unavailable");
+  }
+  return row as { sessionId: string; isStreaming: false; messageCount: number };
+}
+
+async function idleSession(nativeId: string, { create }: { create: boolean }): Promise<AgentSessionWrapper> {
+  let session = getRpcSession(nativeId);
+  if (!session?.isAlive()) {
+    if (!create) throw new Error("fixture process unavailable");
+    session = (await startRpcSession(nativeId, "", fixtureRoot(), {
+      sessionId: nativeId,
+      toolNames: ["read"],
+      propagationFixture: true,
+    })).session;
+  }
+  if (!session.isAlive() || session.isRunning() || session.inner.sessionId !== nativeId) {
+    throw new Error("fixture process unavailable");
+  }
+  return session;
+}
+
+function probeSucceeded(
+  events: AgentEvent[], path: string, marker: string, expectedText: string,
+): boolean {
+  const starts = events.filter((event) => event.type === "tool_execution_start");
+  const ends = events.filter((event) => event.type === "tool_execution_end");
+  const completed = events.filter((event) => event.type === "agent_end");
+  const textEnds = events.map((event) => event.assistantMessageEvent)
+    .filter((event): event is Record<string, unknown> => Boolean(
+      event && typeof event === "object" && !Array.isArray(event)
+      && (event as Record<string, unknown>).type === "text_end",
+    ));
+  if (starts.length !== 1 || ends.length !== 1 || completed.length !== 1
+      || starts[0].toolName !== "read" || ends[0].toolName !== "read"
+      || starts[0].toolCallId !== ends[0].toolCallId
+      || JSON.stringify(starts[0].args) !== JSON.stringify({ path })
+      || ends[0].isError !== false
+      || textEnds.length < 1
+      || String(textEnds.at(-1)?.content ?? "").trim() !== expectedText) return false;
+  const result = ends[0].result;
+  if (!result || typeof result !== "object" || Array.isArray(result)) return false;
+  const content = (result as Record<string, unknown>).content;
+  return Array.isArray(content) && content.length === 1
+    && content[0] && typeof content[0] === "object"
+    && (content[0] as Record<string, unknown>).type === "text"
+    && (content[0] as Record<string, unknown>).text === marker;
+}
+
+async function runProbe(
+  session: AgentSessionWrapper,
+  phase: string,
+  marker: string,
+  cancelled: Promise<void>,
+  previousMarker?: string,
+) {
+  const path = join(fixtureRoot(), `${phase}-${randomUUID()}.txt`);
+  let descriptor = -1;
+  const events: AgentEvent[] = [];
+  let resolveCompletion!: () => void;
+  let rejectCompletion!: (error: Error) => void;
+  const completion = new Promise<void>((resolve, reject) => {
+    resolveCompletion = resolve;
+    rejectCompletion = reject;
+  });
+  const unsubscribe = session.onEvent((event) => {
+    if (events.length >= MAX_EVENTS) {
+      rejectCompletion(new Error("fixture emitted too many events"));
+      return;
+    }
+    events.push(event);
+    if (event.type === "error" || event.type === "prompt_error") rejectCompletion(new Error("fixture turn failed"));
+    if (event.type === "agent_end") resolveCompletion();
+  });
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    descriptor = openSync(path, "wx", 0o600);
+    writeFileSync(descriptor, marker, { encoding: "ascii" });
+    fsyncSync(descriptor);
+    closeSync(descriptor);
+    descriptor = -1;
+    const message = previousMarker === undefined
+      ? `Use the read tool exactly once on this fixture file and reply with only its exact contents: ${path}`
+      : "Reply with the exact token from your immediately preceding assistant response, then a newline. "
+        + "Use the read tool exactly once on this fixture file and append only its exact contents after "
+        + `that newline: ${path}`;
+    const sendOutcome = await Promise.race([
+      session.send({ type: "prompt", message }).then(() => "sent" as const),
+      cancelled.then(() => "cancelled" as const),
+    ]);
+    if (sendOutcome === "cancelled") throw new Error("fixture cancelled");
+    const outcome = await Promise.race([
+      completion.then(() => "completed" as const),
+      cancelled.then(() => "cancelled" as const),
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => reject(new Error("fixture turn timed out")), TURN_TIMEOUT_MS);
+      }),
+    ]);
+    if (outcome === "cancelled") throw new Error("fixture cancelled");
+    const boundaryDeadline = Date.now() + 5_000;
+    while (session.isRunning() && Date.now() < boundaryDeadline) {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+    const expectedText = previousMarker === undefined ? marker : `${previousMarker}\n${marker}`;
+    if (session.isRunning() || !probeSucceeded(events, path, marker, expectedText)) {
+      throw new Error("fixture turn did not complete exactly");
+    }
+    return await sessionState(session);
+  } finally {
+    if (timer) clearTimeout(timer);
+    unsubscribe();
+    if (descriptor >= 0) closeSync(descriptor);
+    try { unlinkSync(path); } catch {}
+  }
+}
+
+function observation(session: AgentSessionWrapper, startedAt: string, historyProbePassed: boolean) {
+  const observed = observePropagationSession(session.sessionId);
+  if (!observed.loaded || observed.busy || !observed.model || !observed.catalog_digest) {
+    throw new Error("loaded state unavailable");
+  }
+  return {
+    schema: "pi-web-propagation-turn/v1" as const,
+    started_at: startedAt,
+    completed_at: utcSeconds(),
+    native_session_id: session.sessionId,
+    process_generation: session.propagationProcessGeneration,
+    configured_route: true,
+    provider: observed.model.provider,
+    model: observed.model.id,
+    context_tokens: observed.model.contextWindow,
+    max_output_tokens: observed.model.maxTokens,
+    loaded_catalog_digest: observed.catalog_digest,
+    turn_completed: true,
+    tool_probe_passed: true,
+    history_probe_passed: historyProbePassed,
+    fallback_used: false,
+  };
+}
+
+export async function runPropagationAcceptance(value: unknown) {
+  const body = request(value);
+  const operationId = body.operation_id as string;
+  const nativeId = fixtureId(body.native_id);
+  if (body.action === "prepare_existing") {
+    if (!exactKeys(body, ["v", "action", "operation_id", "native_id"])) throw new Error("invalid request");
+    const prepared = reserveOperation(operationId, nativeId);
+    let session: AgentSessionWrapper | undefined;
+    try {
+      session = await idleSession(nativeId, { create: true });
+      prepared.session = session;
+      prepared.processGeneration = session.propagationProcessGeneration;
+      prepared.historyMarker = `PI-FIXTURE-${randomUUID().replaceAll("-", "")}`;
+      requireNotCancelled(operationId, nativeId);
+      const state = await runProbe(
+        session, "before", prepared.historyMarker, prepared.cancelled,
+      );
+      if (registry().get(operationId) !== prepared || !session.isAlive()) throw new Error("fixture cancelled");
+      prepared.messageCount = state.messageCount;
+      prepared.preparedAt = utcSeconds();
+      return {
+        schema: "pi-web-propagation-fixture/v1" as const,
+        prepared_at: prepared.preparedAt,
+        native_session_id: nativeId,
+        process_generation: prepared.processGeneration,
+        history_marker: prepared.historyMarker,
+      };
+    } catch (error) {
+      if (registry().get(operationId) === prepared) registry().delete(operationId);
+      if (session?.isAlive()) await session.shutdown();
+      throw error;
+    } finally {
+      endFlight(prepared);
+    }
+  }
+  if (body.action === "complete_existing") {
+    if (!exactKeys(body, ["v", "action", "operation_id", "native_id"])) throw new Error("invalid request");
+    requireNotCancelled(operationId, nativeId);
+    const prepared = registry().get(operationId);
+    if (!prepared || !prepared.preparedAt || prepared.nativeId !== nativeId) throw new Error("fixture process changed");
+    beginFlight(prepared);
+    let session: AgentSessionWrapper | undefined;
+    try {
+      session = await idleSession(nativeId, { create: false });
+      if (prepared.session !== session
+          || prepared.processGeneration !== session.propagationProcessGeneration) {
+        throw new Error("fixture process changed");
+      }
+      const startedAt = utcSeconds();
+      const state = await runProbe(
+        session,
+        "after",
+        `PI-FIXTURE-${randomUUID().replaceAll("-", "")}`,
+        prepared.cancelled,
+        prepared.historyMarker,
+      );
+      if (state.messageCount <= prepared.messageCount) throw new Error("fixture history did not advance");
+      return observation(session, startedAt, true);
+    } finally {
+      if (registry().get(operationId) === prepared) registry().delete(operationId);
+      if (session?.isAlive()) await session.shutdown();
+      endFlight(prepared);
+    }
+  }
+  if (body.action === "cancel_existing") {
+    if (!exactKeys(body, ["v", "action", "operation_id", "native_id"])) throw new Error("invalid request");
+    const prepared = registry().get(operationId);
+    const priorCancellation = cancellations().get(operationId);
+    const priorClosed = closedCancellations().get(operationId);
+    if ((prepared && prepared.nativeId !== nativeId)
+        || (priorCancellation !== undefined && priorCancellation !== nativeId)
+        || (priorClosed !== undefined && priorClosed !== nativeId)) {
+      throw new Error("fixture identity conflict");
+    }
+    if (!prepared) {
+      if (priorClosed === nativeId) {
+        return { schema: "pi-web-propagation-cancel/v1" as const, closed: true };
+      }
+      cancellations().set(operationId, nativeId);
+      throw new Error("fixture ownership unavailable");
+    }
+    cancellations().set(operationId, nativeId);
+    prepared.cancel();
+    await prepared.inFlight;
+    const session = prepared.session;
+    if (session?.isAlive()) await session.shutdown();
+    if (session?.isAlive()) throw new Error("fixture process did not stop");
+    if (registry().get(operationId) === prepared) registry().delete(operationId);
+    if (!prepared.processGeneration) {
+      throw new Error("fixture process identity unavailable");
+    }
+    closedCancellations().set(operationId, nativeId);
+    return { schema: "pi-web-propagation-cancel/v1" as const, closed: true };
+  }
+  if (body.action === "accept_new") {
+    if (!exactKeys(body, ["v", "action", "operation_id", "native_id", "previous_native_id"])) {
+      throw new Error("invalid request");
+    }
+    const previous = fixtureId(body.previous_native_id);
+    if (previous === nativeId) throw new Error("fixture conflict");
+    const pending = reserveOperation(operationId, nativeId);
+    const startedAt = utcSeconds();
+    let session: AgentSessionWrapper | undefined;
+    try {
+      session = await idleSession(nativeId, { create: true });
+      pending.session = session;
+      pending.processGeneration = session.propagationProcessGeneration;
+      requireNotCancelled(operationId, nativeId);
+      await runProbe(
+        session, "new", `PI-FIXTURE-${randomUUID().replaceAll("-", "")}`,
+        pending.cancelled,
+      );
+      if (registry().get(operationId) !== pending || !session.isAlive()) throw new Error("fixture cancelled");
+      return observation(session, startedAt, false);
+    } finally {
+      if (registry().get(operationId) === pending) registry().delete(operationId);
+      if (session?.isAlive()) await session.shutdown();
+      endFlight(pending);
+    }
+  }
+  throw new Error("invalid request");
+}
