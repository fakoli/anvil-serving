+import { NextResponse } from "next/server";
+import { bridgeAuthorized, listWorkbenchSessions } from "@/lib/workbench-bridge";
+
+export async function GET(request: Request) {
+  if (!bridgeAuthorized(request.headers.get("authorization"))) return NextResponse.json({ error: "not found" }, { status: 404 });
