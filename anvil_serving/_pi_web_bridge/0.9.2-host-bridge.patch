+const VOICE_WAVE_BARS = 18;
+
+/**
+ * Live dictation wave for the message bar: thin bars bounce with per-bar
+ * phase while the container's --voice-wave-level custom property (written
+ * from the mic analyser on each frame) scales the amplitude, so the user
+ * can tell the mic is picking up sound.
+ */
+function VoiceWave({ levelRef }: { levelRef: React.RefObject<number> }) {
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  useEffect(() => {
+    if (typeof window === "undefined" || typeof window.requestAnimationFrame !== "function") return;
+    let raf = 0;
+    let smoothed = 0;
+    const tick = () => {
+      raf = window.requestAnimationFrame(tick);
+      const el = containerRef.current;
+      if (!el) return;
+      const target = Math.min(1, Math.max(0, levelRef.current));
+      smoothed = smoothed * 0.7 + target * 0.3;
+      el.style.setProperty("--voice-wave-level", smoothed.toFixed(3));
+    };
+    raf = window.requestAnimationFrame(tick);
+    return () => window.cancelAnimationFrame(raf);
+  }, [levelRef]);
+  return (
+    <div
+      ref={containerRef}
+      className="voice-wave"
+      aria-hidden="true"
+      style={{ "--voice-wave-level": 0 } as React.CSSProperties}
+    >
+      {Array.from({ length: VOICE_WAVE_BARS }, (_, i) => (
+        <span
+          key={i}
+          style={{
+            animationDelay: `${(-((i % 5) * 0.17)).toFixed(2)}s`,
+            animationDuration: `${(0.85 + (i % 3) * 0.12).toFixed(2)}s`,
+          }}
+        />
+      ))}
+    </div>
+  );
+}
