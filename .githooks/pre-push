#!/usr/bin/env bash
# pre-push: backstop that no pushed tree carries a stale CLI-reference
# inventory (the docs-audit CI check would fail on it).
#
# For each branch ref being pushed, the pushed SHA is validated hermetically
# in a throwaway worktree (the current worktree is never touched). If the
# checked-in inventory is stale, the generated artifacts are regenerated on
# top of the pushed SHA, committed, and the local branch is fast-forwarded;
# the push is then rejected so the next `git push` delivers the fresh state.
#
# Fail-closed: if the state cannot be verified (worktree creation failed,
# python3 missing) or the regeneration cannot be committed (missing git
# identity, active audit violations), the push is rejected with guidance.
set -u

ZERO=0000000000000000000000000000000000000000
blocked=0
tmp=""

cleanup() {
  [ -n "$tmp" ] && rm -rf "$tmp" 2>/dev/null
}
trap cleanup EXIT INT TERM

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$ZERO" ] && continue  # branch deletion

  branch=${local_ref#refs/heads/}
  tmp=$(mktemp -d)
  if ! git worktree add --detach --force -q "$tmp" "$local_sha" 2>/dev/null; then
    echo "pre-push: push rejected — could not create a throwaway worktree to verify '$branch' at ${local_sha:0:12}." >&2
    echo "pre-push: fix the local git state (git worktree list / git worktree prune) and re-run: git push" >&2
    tmp=""
    blocked=1
    continue
  fi

  if (cd "$tmp" && python3 scripts/audit_cli_references.py --check --scope full >/dev/null 2>&1); then
    git worktree remove --force "$tmp" 2>/dev/null
    tmp=""
    continue
  fi

  # Stale: regenerate the generated artifacts on top of the pushed SHA.
  if (cd "$tmp" && python3 scripts/audit_cli_references.py --update >/dev/null 2>&1) \
    && (cd "$tmp" && git add docs/CLI.md docs/CLI-REFERENCE-AUDIT.json tests/fixtures/cli_reference_audit/expected.json \
      && git commit -q -m "docs: regenerate the CLI reference inventory (pre-push backstop)"); then
    new_sha=$(cd "$tmp" && git rev-parse HEAD)
  else
    new_sha=""
  fi
  git worktree remove --force "$tmp" 2>/dev/null
  git worktree prune 2>/dev/null
  tmp=""

  if [ -n "$new_sha" ] && [ "$new_sha" != "$local_sha" ]; then
    tip=$(git rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null || true)
    if [ -n "$tip" ] && git merge-base --is-ancestor "$local_sha" "$tip" 2>/dev/null; then
      git update-ref "refs/heads/$branch" "$new_sha"
      echo "pre-push: push rejected — the pushed tree had a stale CLI-reference inventory." >&2
      echo "pre-push: regenerated artifacts committed as ${new_sha:0:12} and '$branch' fast-forwarded. Re-run: git push" >&2
    else
      echo "pre-push: push rejected — the pushed tree had a stale CLI-reference inventory (docs-audit would fail)." >&2
      echo "pre-push: regenerated copy is ${new_sha:0:12}; commit it (or rebase onto it) on '$branch' and re-push." >&2
    fi
    blocked=1
  else
    # Stale tree, but the regeneration could not be committed (missing git
    # identity, active audit violations, ...). Fail closed.
    echo "pre-push: push rejected — the pushed tree had a stale CLI-reference inventory and the regeneration could not be committed automatically." >&2
    echo "pre-push: run 'python3 scripts/audit_cli_references.py --update' (fix any reported violations first), commit the regenerated artifacts, and re-push." >&2
    blocked=1
  fi
done

exit "$blocked"
