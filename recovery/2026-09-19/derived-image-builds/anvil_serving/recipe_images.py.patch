--- /dev/null
+++ b/anvil_serving/recipe_images.py
@@ -0,0 +1,265 @@
+"""Guarded derived-image builds declared by serve recipes.
+
+The serving lifecycle remains owned by ``models recipes load``.  This module
+only prepares a recipe's exact local image through a reviewable ``docker build``
+plan, then verifies that the resulting tag carries the expected provenance
+labels before it can be used by the normal recipe loader.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import PurePosixPath
+import re
+import subprocess
+
+
+MANAGED_LABEL = "io.anvil-serving.managed-by"
+MODEL_LABEL = "io.anvil-serving.recipe.model"
+RECIPE_DIGEST_LABEL = "io.anvil-serving.recipe.digest"
+CONTEXT_DIGEST_LABEL = "io.anvil-serving.image-build.context-digest"
+_IMAGE_RE = re.compile(
+    r"^(?:[A-Za-z0-9.-]+(?::[0-9]+)?/)?"
+    r"[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*"
+    r":[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
+)
+
+
+class RecipeImageError(ValueError):
+    """A declared recipe image build is invalid or failed verification."""
+
+
+def _relative_parts(value: object, field: str) -> tuple[str, ...]:
+    if (
+        not isinstance(value, str)
+        or not value
+        or value in {".", ".."}
+        or "\\" in value
+        or any(character in value for character in "\x00\r\n")
+    ):
+        raise RecipeImageError(
+            "%s must be a normalized relative POSIX path" % field
+        )
+    path = PurePosixPath(value)
+    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
+        raise RecipeImageError(
+            "%s must be a normalized relative POSIX path" % field
+        )
+    return tuple(path.parts)
+
+
+def _resolve_inside(base: str, parts: tuple[str, ...], field: str) -> str:
+    resolved_base = os.path.realpath(base)
+    resolved = os.path.realpath(os.path.join(resolved_base, *parts))
+    try:
+        inside = os.path.commonpath((resolved_base, resolved)) == resolved_base
+    except ValueError:
+        inside = False
+    if not inside:
+        raise RecipeImageError("%s resolves outside the operator registry directory" % field)
+    return resolved
+
+
+def _hash_file(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _hash_context(path: str) -> tuple[str, int, int]:
+    digest = hashlib.sha256()
+    file_count = 0
+    byte_count = 0
+    for base, directories, files in os.walk(path, followlinks=False):
+        directories.sort()
+        files.sort()
+        for name in directories:
+            candidate = os.path.join(base, name)
+            if os.path.islink(candidate):
+                raise RecipeImageError(
+                    "recipe.image_build.context must not contain symbolic links"
+                )
+        for name in files:
+            candidate = os.path.join(base, name)
+            if os.path.islink(candidate) or not os.path.isfile(candidate):
+                raise RecipeImageError(
+                    "recipe.image_build.context must contain regular files only"
+                )
+            relative = os.path.relpath(candidate, path).replace(os.sep, "/")
+            encoded = relative.encode("utf-8")
+            digest.update(len(encoded).to_bytes(8, "big"))
+            digest.update(encoded)
+            size = os.path.getsize(candidate)
+            digest.update(size.to_bytes(8, "big"))
+            with open(candidate, "rb") as handle:
+                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                    digest.update(chunk)
+            file_count += 1
+            byte_count += size
+    if not file_count:
+        raise RecipeImageError("recipe.image_build.context must not be empty")
+    return digest.hexdigest(), file_count, byte_count
+
+
+def _recipe_digest(recipe: dict) -> str:
+    payload = json.dumps(
+        recipe, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _inspect_image(image: str, *, _run=subprocess.run) -> dict | None:
+    try:
+        completed = _run(
+            ["docker", "image", "inspect", image],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+    except OSError as exc:
+        raise RecipeImageError("cannot inspect Docker image %r: %s" % (image, exc)) from None
+    if completed.returncode:
+        detail = (completed.stderr or completed.stdout or "").strip()
+        if "no such image" in detail.lower():
+            return None
+        raise RecipeImageError("cannot inspect Docker image %r: %s" % (image, detail))
+    try:
+        rows = json.loads(completed.stdout)
+        row = rows[0]
+        labels = (row.get("Config") or {}).get("Labels") or {}
+    except (IndexError, TypeError, ValueError, AttributeError):
+        raise RecipeImageError("Docker returned malformed image identity for %r" % image) from None
+    return {
+        "image": image,
+        "image_id": row.get("Id"),
+        "repo_digests": row.get("RepoDigests") or [],
+        "labels": labels,
+    }
+
+
+def build_plan(recipe: dict, registry_path: str, *, _run=subprocess.run) -> dict:
+    """Resolve a deterministic Docker build plan rooted beside the registry."""
+    if not isinstance(recipe, dict):
+        raise RecipeImageError("recipe must be a table")
+    model = recipe.get("model")
+    if not isinstance(model, str) or not model:
+        raise RecipeImageError("recipe.model must be a non-empty string")
+    serve = recipe.get("serve")
+    image_build = recipe.get("image_build")
+    if not isinstance(serve, dict) or not isinstance(image_build, dict):
+        raise RecipeImageError(
+            "recipe.serve and recipe.image_build tables are required to build an image"
+        )
+    allowed = {"context", "dockerfile", "pull", "no_cache", "platform"}
+    extras = sorted(str(key) for key in image_build if key not in allowed)
+    if extras:
+        raise RecipeImageError(
+            "unsupported recipe.image_build field(s): %s" % ", ".join(extras)
+        )
+    image = serve.get("image")
+    if (
+        not isinstance(image, str)
+        or not _IMAGE_RE.fullmatch(image)
+        or image.rsplit(":", 1)[-1].lower() == "latest"
+    ):
+        raise RecipeImageError(
+            "recipe.serve.image must be a non-latest tagged image name for a derived-image build"
+        )
+    for key in ("pull", "no_cache"):
+        if key in image_build and not isinstance(image_build[key], bool):
+            raise RecipeImageError("recipe.image_build.%s must be a boolean" % key)
+    platform = image_build.get("platform")
+    if platform is not None and (
+        not isinstance(platform, str)
+        or not re.fullmatch(r"linux/(?:amd64|arm64)", platform)
+    ):
+        raise RecipeImageError(
+            "recipe.image_build.platform must be linux/amd64 or linux/arm64"
+        )
+    registry = os.path.abspath(registry_path)
+    registry_dir = os.path.dirname(registry)
+    context = _resolve_inside(
+        registry_dir,
+        _relative_parts(image_build.get("context"), "recipe.image_build.context"),
+        "recipe.image_build.context",
+    )
+    if os.path.islink(context) or not os.path.isdir(context):
+        raise RecipeImageError("recipe.image_build.context must resolve to a directory")
+    dockerfile = _resolve_inside(
+        context,
+        _relative_parts(
+            image_build.get("dockerfile", "Dockerfile"),
+            "recipe.image_build.dockerfile",
+        ),
+        "recipe.image_build.dockerfile",
+    )
+    if os.path.islink(dockerfile) or not os.path.isfile(dockerfile):
+        raise RecipeImageError("recipe.image_build.dockerfile must resolve to a regular file")
+    context_digest, file_count, byte_count = _hash_context(context)
+    recipe_digest = _recipe_digest(recipe)
+    argv = ["docker", "build"]
+    if image_build.get("pull", True):
+        argv.append("--pull")
+    if image_build.get("no_cache", False):
+        argv.append("--no-cache")
+    if platform:
+        argv += ["--platform", platform]
+    argv += [
+        "--file", dockerfile,
+        "--tag", image,
+        "--label", "%s=models-recipes-image" % MANAGED_LABEL,
+        "--label", "%s=%s" % (MODEL_LABEL, model),
+        "--label", "%s=%s" % (RECIPE_DIGEST_LABEL, recipe_digest),
+        "--label", "%s=%s" % (CONTEXT_DIGEST_LABEL, context_digest),
+        context,
+    ]
+    return {
+        "schema": "recipe-image-build-plan/v1",
+        "registry": registry,
+        "model": model,
+        "image": image,
+        "context": context,
+        "context_digest": context_digest,
+        "context_file_count": file_count,
+        "context_bytes": byte_count,
+        "dockerfile": dockerfile,
+        "dockerfile_digest": _hash_file(dockerfile),
+        "recipe_digest": recipe_digest,
+        "previous_image": _inspect_image(image, _run=_run),
+        "argv": argv,
+    }
+
+
+def run_build(plan: dict, *, _run=subprocess.run) -> dict:
+    """Run one reviewed plan and independently verify its resulting image labels."""
+    try:
+        completed = _run(plan["argv"], check=False)
+    except OSError as exc:
+        raise RecipeImageError("cannot run Docker image build: %s" % exc) from None
+    if completed.returncode:
+        raise RecipeImageError(
+            "Docker image build failed with exit code %s" % completed.returncode
+        )
+    identity = _inspect_image(plan["image"], _run=_run)
+    if identity is None:
+        raise RecipeImageError("Docker build returned success but the target image is absent")
+    expected = {
+        MANAGED_LABEL: "models-recipes-image",
+        MODEL_LABEL: plan["model"],
+        RECIPE_DIGEST_LABEL: plan["recipe_digest"],
+        CONTEXT_DIGEST_LABEL: plan["context_digest"],
+    }
+    mismatches = [
+        name for name, value in expected.items()
+        if identity["labels"].get(name) != value
+    ]
+    if mismatches:
+        raise RecipeImageError(
+            "built image failed provenance verification (%s mismatch)"
+            % ", ".join(mismatches)
+        )
+    return identity
