 class RecipeError(ValueError):
     """A recipe or recipe registry is invalid for a requested operation."""
+
+
+def _resolved_healthcheck(serve: dict) -> dict | None:
+    """Validate and normalize one bounded engine-neutral HTTP healthcheck."""
+    healthcheck = serve.get("healthcheck")
+    if healthcheck is None:
+        return None
+    if not isinstance(healthcheck, dict):
+        raise RecipeError("recipe.serve.healthcheck must be a table")
+    unknown = sorted(set(healthcheck) - {
+        "mode", "port", "path", "interval_seconds", "timeout_seconds",
+        "start_period_seconds", "retries",
+    })
+    if unknown:
+        raise RecipeError(
+            "recipe.serve.healthcheck has unsupported field(s): %s"
+            % ", ".join(unknown)
+        )
+    if healthcheck.get("mode") != "http":
+        raise RecipeError("recipe.serve.healthcheck.mode must be 'http'")
+    port = healthcheck.get("port")
+    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
+        raise RecipeError(
+            "recipe.serve.healthcheck.port must be an integer from 1 to 65535"
+        )
+    path = healthcheck.get("path")
+    path_parts = path.split("/")[1:] if isinstance(path, str) else []
+    if (
+        not isinstance(path, str)
+        or not _HEALTHCHECK_PATH_RE.fullmatch(path)
+        or (path != "/" and any(part in {"", ".", ".."} for part in path_parts))
+    ):
+        raise RecipeError(
+            "recipe.serve.healthcheck.path must be a normalized absolute HTTP path"
+        )
+    resolved = {
+        "mode": "http",
+        "port": port,
+        "path": path,
+        **_HEALTHCHECK_DEFAULTS,
+        "start_period_seconds": serve.get("startup_timeout_seconds", 600),
+    }
+    for key in (
+        "interval_seconds", "timeout_seconds", "start_period_seconds", "retries"
+    ):
+        value = healthcheck.get(key, resolved[key])
+        upper = 100 if key == "retries" else 86400
+        if (
+            isinstance(value, bool)
+            or not isinstance(value, int)
+            or not 1 <= value <= upper
+        ):
+            raise RecipeError(
+                "recipe.serve.healthcheck.%s must be an integer from 1 to %s"
+                % (key, upper)
+            )
+        resolved[key] = value
+    resolved["target"] = "http://127.0.0.1:%s%s" % (port, path)
+    return resolved
+
+
