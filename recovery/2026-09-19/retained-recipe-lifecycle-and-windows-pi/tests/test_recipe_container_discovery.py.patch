+@pytest.mark.parametrize("state,running,health", [
+    ("running", True, None), ("exited", False, "unhealthy"),
+])
+def test_recipe_start_never_calls_unhealthy_or_exited_state_healthy(
+    state, running, health, monkeypatch, capsys,
+):
+    identity = serve_recipes._recipe_container_record(_row("candidate"))
+    observed = {**identity, "state": state, "running": running, "health": health}
+    monkeypatch.setattr(models, "_recheck_discovered_recipe_container", lambda *a, **kw: observed)
+    rc = models._discovered_recipe_container_start(
+        identity, confirm=True, _run=lambda argv, **kw: _completed(argv),
+        _sleep=lambda _: pytest.fail("terminal or missing health must fail immediately"),
+        _admit=lambda *a, **kw: None,
+    )
+    assert rc == 1
+    assert "state is healthy" not in capsys.readouterr().out
+
