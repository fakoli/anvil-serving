+def test_discovered_recipe_stop_retains_revalidated_immutable_container(
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    selected = serve_recipes._recipe_container_record(_row("candidate"))
+    stopped = serve_recipes._recipe_container_record(
+        _row("candidate", state="exited", running=False)
+    )
+    assert selected is not None and stopped is not None
+    inventories = iter((selected, stopped))
+    monkeypatch.setattr(
+        serve_recipes,
+        "discover_recipe_containers",
+        lambda **_kwargs: {
+            "schema": serve_recipes.RECIPE_CONTAINER_INVENTORY_SCHEMA,
+            "containers": [next(inventories)],
+        },
+    )
+    calls = []
+
+    assert models._discovered_recipe_container_stop(
+        selected,
+        timeout_seconds=17,
+        confirm=True,
+        _run=lambda argv, **_kwargs: calls.append(argv) or _completed(argv),
+    ) == 0
+
+    assert calls == [["docker", "stop", "--time", "17", selected["container_id"]]]
+    assert "stopped recipe container" in capsys.readouterr().out
+
+
+def test_discovered_recipe_start_waits_for_same_container_to_be_healthy(
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    selected = serve_recipes._recipe_container_record(
+        _row("candidate", state="exited", running=False)
+    )
+    started = serve_recipes._recipe_container_record(_row("candidate"))
+    assert selected is not None and started is not None
+    inventories = iter((selected, selected, started))
+    monkeypatch.setattr(
+        serve_recipes,
+        "discover_recipe_containers",
+        lambda **_kwargs: {
+            "schema": serve_recipes.RECIPE_CONTAINER_INVENTORY_SCHEMA,
+            "containers": [next(inventories)],
+        },
+    )
+    calls = []
+
+    assert models._discovered_recipe_container_start(
+        selected,
+        timeout_seconds=17,
+        confirm=True,
+        _run=lambda argv, **_kwargs: calls.append(argv) or _completed(argv),
+        _admit=lambda *a, **kw: None,
+    ) == 0
+
+    assert calls == [["docker", "start", selected["container_id"]]]
+    assert "healthy" in capsys.readouterr().out
+
