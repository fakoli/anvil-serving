+@pytest.mark.parametrize("action", ["stop", "start"])
+def test_recipe_restart_known_registry_uses_full_discovered_identity(action, monkeypatch):
+    recipe = {"model": "org/model", "download": {"revision": "a" * 40},
+              "serve": {"image": "example:test"}}
+    identity = serve_recipes._recipe_container_record(_row("candidate"))
+    monkeypatch.setattr(serve_recipes, "load_registry", lambda *a, **kw: {"recipe": [recipe]})
+    monkeypatch.setattr(models, "_native_recipe_binding", lambda *a: None)
+    monkeypatch.setattr(models, "_recipe_container_identity", lambda *a, **kw: {
+        "container": "candidate", "model": "org/model", "revision": "a" * 40,
+        "container_id": identity["container_id"], "image_id": identity["image_digest"],
+    })
+    monkeypatch.setattr(serve_recipes, "discover_recipe_containers", lambda **kw: {
+        "containers": [identity],
+    })
+    seen = []
+    monkeypatch.setattr(models, "_discovered_recipe_container_" + action,
+                        lambda value, **kw: seen.append(value) or 0)
+    assert models._recipe_main([action, "org/model", "--container", "candidate", "--confirm"]) == 0
+    assert seen == [identity]
+
