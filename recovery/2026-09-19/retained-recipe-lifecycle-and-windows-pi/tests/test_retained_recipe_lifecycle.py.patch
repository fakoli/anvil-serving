+def test_mcp_status_without_registry_resolves_cli_default(monkeypatch, tmp_path):
+    selected = identity()
+    registry = str(tmp_path / "recipes.toml")
+    monkeypatch.setattr(models, "_default_registry", lambda: registry)
+    import contextlib
+    monkeypatch.setattr(serve_recipes, "registry_lock", lambda _: contextlib.nullcontext())
+    seen = []
+    monkeypatch.setattr(tools, "_recipe_manage_snapshot", lambda path, *a: (
+        seen.append(path) or {"model": "org/model"}, {"model": "org/model"}, selected))
+    assert tools.tool_recipe_manage({"action": "status", "model": "org/model", "container": "candidate"})["ok"]
+    assert seen == [registry]
+
+
+@pytest.mark.parametrize("extra", [False, True, "absent"])
+def test_only_declared_baseline_compute_client_is_retained(monkeypatch, extra):
+    monkeypatch.setattr(serves, "deny_ad_hoc_compose_during_exclusive", lambda *a, **kw: None)
+    def run(argv, **kw):
+        output = ""
+        if "--query-compute-apps=pid" in argv:
+            output = "" if extra == "absent" else "42\n43" if extra else "42"
+        elif argv[0] == "nvidia-smi":
+            output = "0, GPU-00000000-0000-0000-0000-000000000001, 1, 16"
+        return subprocess.CompletedProcess(argv, 0, output, "")
+    if extra:
+        with pytest.raises(serve_recipes.RecipeError, match="compute"):
+            models._retained_recipe_start_admission(identity(), _run=run, baseline_compute_pids=[42])
+    else:
+        models._retained_recipe_start_admission(identity(), _run=run, baseline_compute_pids=[42])
+
+
+def test_mcp_baseline_allowance_change_invalidates_preview(monkeypatch):
+    monkeypatch.setattr(serve_recipes, "discover_recipe_containers", lambda **kw: {"containers": [identity()]})
+    monkeypatch.setattr(models, "_discovered_recipe_container_start", lambda *a, **kw: 0)
+    args = {"action": "start", "model": "org/model", "container": "candidate", "baseline_compute_pids": [42]}
+    preview = tools.tool_recipe_manage(args)["data"]
+    with pytest.raises(ToolError, match="preview"):
+        tools.tool_recipe_manage({**args, "baseline_compute_pids": [43], "dry_run": False, "confirm": True,
+                                  "expected_inventory_sha256": preview["inventory_sha256"]})
