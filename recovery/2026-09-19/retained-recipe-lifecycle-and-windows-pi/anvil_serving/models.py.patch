+def _discovered_recipe_container_start(
+    identity,
+    *,
+    timeout_seconds=30,
+    dry_run=False,
+    confirm=False,
+    _run=subprocess.run,
+    _sleep=time.sleep,
+    _clock=time.monotonic,
+    _admit=None,
+    baseline_compute_pids=(),
+):
+    """Start one retained label-owned recipe container and wait for health."""
+    timeout_seconds = _recipe_operation_timeout(timeout_seconds)
+    if (len(baseline_compute_pids) > 16
+            or any(type(pid) is not int or not 1 <= pid <= 2147483647 for pid in baseline_compute_pids)):
+        raise serve_recipes.RecipeError("baseline compute PIDs must be at most 16 positive process IDs")
+    if identity.get("native_kv_offload") is not False:
+        raise serve_recipes.RecipeError("retained native KV offload or unknown offload containers require managed unload/load preparation, not start")
+    if _admit is None:
+        def _admit(selected, *, _run):
+            return _retained_recipe_start_admission(selected, _run=_run, baseline_compute_pids=baseline_compute_pids)
+    if dry_run:
+        if not identity["running"]:
+            _admit(identity, _run=_bounded_recipe_runner(_run, _clock() + timeout_seconds, _clock))
+        print("RECIPE START PLAN")
+        print("container: %s" % identity["container"])
+        print("model: %s" % identity["model"])
+        print("revision: %s" % (identity.get("revision") or "unrecorded"))
+        print("state: %s" % identity["state"])
+        print("declared baseline compute client PIDs: %s" % sorted(set(baseline_compute_pids)))
+        print("ordered actions: rediscover exact recipe identity; start exact retained container; wait for healthy state")
+        print("recovery: inspect bounded logs, then retry this idempotent start")
+        print("deferred until apply: confirmation, identity recheck, and Docker start")
+        return 0
+    if not _confirm_recipe_mutation(
+        "start container %s" % identity["container"],
+        identity["model"],
+        confirm=confirm,
+        dry_run=False,
+    ):
+        return 3
+    deadline = _clock() + timeout_seconds
+    _run = _bounded_recipe_runner(_run, deadline, _clock)
+    current = _recheck_discovered_recipe_container(identity, _run=_run)
+    if current.get("native_kv_offload") is not False:
+        raise serve_recipes.RecipeError("retained native KV offload containers require managed unload/load preparation, not start")
+    if not current["running"]:
+        _admit(current, _run=_run)
+        current = _recheck_discovered_recipe_container(identity, _run=_run)
+        completed = _run(
+            ["docker", "start", current["container_id"]],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+        if completed.returncode:
+            print("recipe start failed", file=sys.stderr)
+            return completed.returncode
+    while True:
+        observed = _recheck_discovered_recipe_container(identity, _run=_run)
+        if observed["state"] == "running" and observed["running"] and observed.get("health") == "healthy":
+            print("started recipe container %r; state is healthy" % observed["container"])
+            return 0
+        if observed["state"] in {"exited", "dead", "removing"} or observed.get("health") is None:
+            print("recipe start has no healthy postcondition (state=%s; health=%s); inspect recipe logs and use managed load if no healthcheck is declared"
+                  % (observed["state"], observed.get("health") or "not-declared"), file=sys.stderr)
+            return 1
+        if _clock() >= deadline:
+            print(
+                "recipe container did not become healthy (state=%s; health=%s; timeout=%ss)"
+                % (observed["state"], observed.get("health") or "not-declared", timeout_seconds),
+                file=sys.stderr,
+            )
+            return 1
+        _sleep(min(LIFECYCLE_READINESS_POLL_SECONDS, max(0, deadline - _clock())))
+
