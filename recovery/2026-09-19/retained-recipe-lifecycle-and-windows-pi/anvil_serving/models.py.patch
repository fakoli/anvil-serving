+def _recipe_operation_timeout(value):
+    if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= 3600:
+        raise serve_recipes.RecipeError("operation timeout must be from 1 through 3600 seconds")
+    return value
+
+
+def _bounded_recipe_runner(run, deadline, clock):
+    def bounded(argv, **kwargs):
+        remaining = deadline - clock()
+        if remaining <= 0:
+            raise serve_recipes.RecipeError("recipe lifecycle operation deadline exceeded; inspect status before retry")
+        kwargs["timeout"] = remaining
+        try:
+            return run(argv, **kwargs)
+        except subprocess.TimeoutExpired:
+            raise serve_recipes.RecipeError("recipe lifecycle command timed out; outcome uncertain, inspect status before retry") from None
+        except OSError as exc:
+            raise serve_recipes.RecipeError("cannot execute recipe lifecycle command: %s" % exc) from None
+    return bounded
+
+
+def _discovered_recipe_container_stop(
+    identity,
+    *,
+    timeout_seconds=30,
+    dry_run=False,
+    confirm=False,
+    _run=subprocess.run,
+    _clock=time.monotonic,
+):
+    """Stop and retain one exact label-owned recipe container."""
+    timeout_seconds = _recipe_operation_timeout(timeout_seconds)
+    if dry_run:
+        print("RECIPE STOP PLAN")
+        print("container: %s" % identity["container"])
+        print("model: %s" % identity["model"])
+        print("revision: %s" % (identity.get("revision") or "unrecorded"))
+        print("state: %s" % identity["state"])
+        print("ordered actions: rediscover exact recipe identity; stop and retain exact container")
+        print("recovery: anvil-serving models recipes start --container %s --confirm" % identity["container"])
+        print("deferred until apply: confirmation and identity recheck")
+        return 0
+    if not _confirm_recipe_mutation(
+        "stop container %s" % identity["container"],
+        identity["model"],
+        confirm=confirm,
+        dry_run=False,
+    ):
+        return 3
+    _run = _bounded_recipe_runner(_run, _clock() + timeout_seconds, _clock)
+    current = _recheck_discovered_recipe_container(identity, _run=_run)
+    if not current["running"]:
+        print("recipe container %r is already stopped" % current["container"])
+        return 0
+    completed = _run(
+        ["docker", "stop", "--time", str(timeout_seconds), current["container_id"]],
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+    )
+    if completed.returncode:
+        print("recipe stop failed", file=sys.stderr)
+        return completed.returncode
+    stopped = _recheck_discovered_recipe_container(identity, _run=_run)
+    if stopped["running"]:
+        print("recipe stop did not reach a stopped postcondition", file=sys.stderr)
+        return 1
+    print("stopped recipe container %r; retained for exact restart" % stopped["container"])
+    return 0
+
