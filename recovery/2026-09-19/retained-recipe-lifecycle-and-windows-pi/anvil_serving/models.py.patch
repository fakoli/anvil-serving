+def _retained_recipe_start_admission(identity, *, _run=subprocess.run, baseline_compute_pids=()):
+    """Conservative isolated recovery; never evict a peer or assume spare capacity."""
+    from . import serves
+
+    denial = serves.deny_ad_hoc_compose_during_exclusive(
+        serves.resolve_manifest_path(), _run=_run,
+    )
+    if denial:
+        raise serve_recipes.RecipeError("retained recipe start denied by managed exclusive ownership; use serves recovery")
+    completed = _run(["docker", "ps", "-q", "--no-trunc"], capture_output=True, text=True)
+    ids = (completed.stdout or "").split()
+    if (completed.returncode or len(ids) > 128 or len(set(ids)) != len(ids)
+            or len(completed.stdout or "") > 128 * 66
+            or any(not re.fullmatch(r"[a-f0-9]{64}", value) for value in ids)):
+        raise serve_recipes.RecipeError("cannot prove Docker GPU ownership before retained start")
+    inspect_format = ('{"Id":{{json .Id}},"State":{"Status":{{json .State.Status}},'
+                      '"Running":{{json .State.Running}}},"HostConfig":{'
+                      '"DeviceRequests":{{if .HostConfig.DeviceRequests}}true{{else}}false{{end}},'
+                      '"Devices":{{if .HostConfig.Devices}}true{{else}}false{{end}},'
+                      '"Runtime":{{if eq .HostConfig.Runtime "nvidia"}}"nvidia"{{else}}"other"{{end}}}}')
+    for offset in range(0, len(ids), 16):
+        chunk = ids[offset:offset + 16]
+        inspected = _run(["docker", "inspect", "--format", inspect_format, *chunk], capture_output=True, text=True)
+        try:
+            if inspected.returncode or len(inspected.stdout or "") > 131072:
+                raise ValueError()
+            rows = [json.loads(line) for line in (inspected.stdout or "").splitlines()]
+            returned = [row["Id"] for row in rows]
+            if len(returned) != len(chunk) or set(returned) != set(chunk):
+                raise ValueError()
+            for row in rows:
+                state = row["State"]
+                if state["Status"] not in {"running", "paused", "restarting"} or type(state["Running"]) is not bool:
+                    raise ValueError()
+                if state["Status"] in {"running", "paused"} and not state["Running"]:
+                    raise ValueError()
+                if row["Id"] == identity["container_id"]:
+                    continue
+                config = row["HostConfig"]
+                gpu = bool(config.get("DeviceRequests") or config.get("Devices") or config.get("Runtime") == "nvidia")
+                if gpu:
+                    raise serve_recipes.RecipeError("retained recipe start denied: another device-owning container is active; use managed lifecycle to reconcile ownership")
+        except serve_recipes.RecipeError:
+            raise
+        except (ValueError, KeyError, TypeError):
+            raise serve_recipes.RecipeError("cannot prove Docker GPU ownership before retained start") from None
+    processes = _run(["nvidia-smi", "--query-compute-apps=pid", "--format=csv,noheader,nounits"],
+                     capture_output=True, text=True)
+    try:
+        observed_pids = {int(value.strip()) for value in (processes.stdout or "").splitlines()}
+    except ValueError:
+        raise serve_recipes.RecipeError("unresolved NVIDIA compute processes") from None
+    if processes.returncode or observed_pids != set(baseline_compute_pids):
+        raise serve_recipes.RecipeError("retained recipe start denied: active or unresolved NVIDIA compute processes")
+    memory = _run(["nvidia-smi", "--query-gpu=index,uuid,count,memory.used", "--format=csv,noheader,nounits"],
+                  capture_output=True, text=True)
+    try:
+        rows = [[part.strip() for part in line.split(",")] for line in (memory.stdout or "").splitlines()]
+        if memory.returncode or not rows or len(rows) > 32 or any(len(row) != 4 for row in rows):
+            raise ValueError()
+        used = [int(row[3]) for row in rows]
+        if (any(int(row[2]) != len(rows) for row in rows)
+                or {int(row[0]) for row in rows} != set(range(len(rows)))
+                or len({row[1] for row in rows}) != len(rows)
+                or any(not re.fullmatch(r"GPU-[a-fA-F0-9-]{36}", row[1]) for row in rows)
+                or any(value < 0 for value in used)):
+            raise ValueError()
+    except ValueError:
+        raise serve_recipes.RecipeError("cannot prove idle GPU capacity before retained start") from None
+    if any(value > 1024 for value in used):
+        raise serve_recipes.RecipeError("retained recipe start requires isolated GPUs with at most 1024 MiB baseline use each; use serves admission for co-residency")
+
