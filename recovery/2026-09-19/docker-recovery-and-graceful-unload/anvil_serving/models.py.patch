+def _stop_and_remove_recipe_container(identity, *, _run=subprocess.run):
+    """Request graceful exit, then remove by immutable ID without forcing it."""
+    kwargs = dict(capture_output=True, text=True, encoding="utf-8", errors="replace")
+    try:
+        if identity["state"] not in {"created", "exited", "dead"}:
+            stopped = _run(
+                ["docker", "stop", "--timeout", "-1", identity["container_id"]],
+                timeout=60, **kwargs,
+            )
+            if stopped.returncode:
+                return stopped
+        # Plain rm also refuses if another actor restarted the container.
+        return _run(["docker", "rm", identity["container_id"]], timeout=30, **kwargs)
+    except subprocess.TimeoutExpired:
+        raise serve_recipes.RecipeError(
+            "graceful recipe unload timed out; inspect status and logs before retrying; "
+            "no forced stop or removal was requested"
+        ) from None
+
