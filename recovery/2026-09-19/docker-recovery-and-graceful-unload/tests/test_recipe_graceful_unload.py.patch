--- /dev/null
+++ b/tests/test_recipe_graceful_unload.py
@@ -0,0 +1,38 @@
+import subprocess
+
+import pytest
+
+from anvil_serving import models, serve_recipes
+
+
+@pytest.mark.parametrize("failure", ["error", "timeout"])
+def test_failed_graceful_stop_never_removes_container(failure):
+    calls = []
+
+    def run(argv, **kwargs):
+        calls.append(argv)
+        assert kwargs["timeout"] == 60
+        if failure == "timeout":
+            raise subprocess.TimeoutExpired(argv, 60)
+        return subprocess.CompletedProcess(argv, 7, "", "stop failed")
+
+    identity = {"container_id": "a" * 64, "state": "running"}
+    if failure == "timeout":
+        with pytest.raises(serve_recipes.RecipeError, match="no forced stop"):
+            models._stop_and_remove_recipe_container(identity, _run=run)
+    else:
+        assert models._stop_and_remove_recipe_container(identity, _run=run).returncode == 7
+    assert calls == [["docker", "stop", "--timeout", "-1", "a" * 64]]
+
+
+def test_exited_container_uses_nonforced_removal():
+    calls = []
+
+    def run(argv, **kwargs):
+        calls.append(argv)
+        return subprocess.CompletedProcess(argv, 0, "", "")
+
+    models._stop_and_remove_recipe_container(
+        {"container_id": "b" * 64, "state": "exited"}, _run=run,
+    )
+    assert calls == [["docker", "rm", "b" * 64]]
