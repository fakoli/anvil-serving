docs/CLI-COMMAND-MANIFEST.json text eol=lf
# The packaged Node entry point is executed on macOS/Linux and must keep its
# shebang byte-stable when built or checked out on Windows.
anvil_serving/_node/*.mjs text eol=lf
mcp_bridge/*.mjs text eol=lf
mcp_bridge/*.json text eol=lf
mcp_bridge/**/*.ts text eol=lf
mcp_bridge/**/*.mjs text eol=lf
# POSIX shell scripts must stay LF: a CRLF working copy injects \r that breaks
# the shebang / `set` lines under Git Bash on Windows.
*.sh text eol=lf
# gate-router parses Markdown frontmatter with POSIX line matching; CRLF makes
# its opening/closing fences invisible and silently empties the rule set.
.claude/gate-router.local.md text eol=lf
# The packaged Hermes media skill is validated and synchronized byte-for-byte.
# Keep both copies LF-stable so Windows checkouts preserve the frontmatter contract.
anvil_serving/_hermes_skills/** text eol=lf
examples/hermes/skills/** text eol=lf
docs/findings/*-evidence/** -text
# Kernel tune artifacts are byte-bound by their manifests. Disable checkout
# conversion so a fresh core.autocrlf=true Windows clone retains their SHA-256.
configs/kernel-tunes/** -text
# Unified-diff context lines may consist of the required single prefix space.
# Keep runtime patch assets LF-stable and exempt their syntax from whitespace
# linting; the derived-image build independently proves that each patch applies.
configs/runtime-patches/**/*.patch text eol=lf -whitespace
# This published historical bundle uses byte hashes as evidence bindings. Keep
# every text artifact LF-stable so the verifier behaves identically on Windows.
docs/findings/eval-data/2026-06-28-planning-capability/** text eol=lf
