{
  "schema": "anvil-connect.connector/v1",
  "id": "origin-a",
  "resources": [
    {
      "rule": {
        "id": "router",
        "host": "api.example.test",
        "path_prefix": "/v1",
        "methods": ["GET", "POST"],
        "access": "api",
        "native_auth": "delegate-bearer",
        "limits": {"request_bytes": 4194304, "concurrent": 16, "buffer_bytes": 65536, "idle_seconds": 120, "duration_seconds": 3600}
      },
      "listen": "127.0.0.1:9082",
      "origin_url": "http://127.0.0.1:19000",
      "token_env": "ANVIL_CONNECT_ROUTER_TOKEN"
    }
  ]
}
