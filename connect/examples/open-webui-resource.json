{
  "schema": "anvil-connect.connector/v1",
  "id": "origin-a",
  "resources": [
    {
      "rule": {
        "id": "open-webui",
        "host": "chat.example.test",
        "path_prefix": "/",
        "methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
        "access": "browser",
        "native_auth": "passthrough",
        "limits": {"request_bytes": 26214400, "concurrent": 32, "buffer_bytes": 65536, "idle_seconds": 30, "duration_seconds": 3600}
      },
      "listen": "127.0.0.1:9084",
      "origin_url": "http://127.0.0.1:3000",
      "token_env": ""
    }
  ]
}