+
+/// A conservative bound on additional fully reserved contexts in one logical pool.
+pub const FullContextInputs = struct {
+    kv: KvAllocation,
+    requested_context_tokens: u64,
+    per_request_reserve_tokens: ?u64 = null,
+    reserve_pages: ?u64 = null,
+    admission_limit: ?u64 = null,
+    active_requests: ?u64 = null,
+    full_context_reservation: bool = false,
+    partitions: u64 = 1,
+};
+pub fn fullContextBound(inputs: FullContextInputs) ?u64 {
+    if (!inputs.kv.valid() or !inputs.full_context_reservation or inputs.partitions != 1 or inputs.requested_context_tokens == 0) return null;
+    const per_request = inputs.per_request_reserve_tokens orelse return null;
+    const reserve = inputs.reserve_pages orelse return null;
+    const limit = inputs.admission_limit orelse return null;
+    const active = inputs.active_requests orelse return null;
+    if (active > limit) return null;
+    const tokens = std.math.add(u64, inputs.requested_context_tokens, per_request) catch return null;
+    const rounded = std.math.add(u64, tokens, inputs.kv.page_size_tokens - 1) catch return null;
+    const pages = rounded / inputs.kv.page_size_tokens;
+    const available = inputs.kv.free_pages - inputs.kv.reserved_pages -| reserve;
+    return @min(limit - active, available / pages);
+}
+
+test "Anvil additional full-context bound requires every policy input and rounds conservatively" {
+    var inputs: FullContextInputs = .{
+        .kv = .{ .allocated_pages = 2, .free_pages = 18, .total_pages = 20, .reserved_pages = 2, .page_size_tokens = 512 },
+        .requested_context_tokens = 1024,
+    };
+    try std.testing.expectEqual(@as(?u64, null), fullContextBound(inputs));
+    inputs.full_context_reservation = true;
+    inputs.per_request_reserve_tokens = 1;
+    inputs.reserve_pages = 1;
+    inputs.admission_limit = 8;
+    inputs.active_requests = 1;
+    try std.testing.expectEqual(@as(?u64, 5), fullContextBound(inputs)); // 15 free / ceil(1025/512)
+    inputs.partitions = 2;
+    try std.testing.expectEqual(@as(?u64, null), fullContextBound(inputs));
+    inputs.partitions = 1;
+    inputs.reserve_pages = 100;
+    try std.testing.expectEqual(@as(?u64, 0), fullContextBound(inputs));
+}
