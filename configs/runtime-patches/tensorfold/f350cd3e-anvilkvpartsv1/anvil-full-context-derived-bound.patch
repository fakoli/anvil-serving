+fn anvilFullContextBound(w: *std.Io.Writer, inputs: ?api.anvil_telemetry.FullContextInputs) !void {
+    const bound = if (inputs) |i| api.anvil_telemetry.fullContextBound(i) else null;
+    try gauge(w, "anvil_full_context_bound_available", "gauge", "One only when every KV and admission-policy input supports a conservative additional-context bound.", @intFromBool(bound != null));
+    if (bound == null) {
+        try w.writeAll("# TYPE tensorfold:anvil_full_context_bound_info gauge\ntensorfold:anvil_full_context_bound_info{reason=\"missing_admission_policy_inputs\"} 1\n");
+        return;
+    }
+    const i = inputs.?;
+    try w.writeAll("# TYPE tensorfold:anvil_full_context_bound_info gauge\ntensorfold:anvil_full_context_bound_info{semantics=\"additional_full_context_requests\",policy=\"full_context_reservation\",formula_version=\"1\"} 1\n");
+    try gauge(w, "anvil_full_context_bound", "gauge", "Conservative additional full-context requests from current free pages and admission slots.", bound.?);
+    try gauge(w, "anvil_full_context_requested_tokens", "gauge", "Requested context tokens for this derivation.", i.requested_context_tokens);
+    try gauge(w, "anvil_full_context_per_request_reserve_tokens", "gauge", "Extra verification and scratch token positions per request.", i.per_request_reserve_tokens.?);
+    try gauge(w, "anvil_full_context_reserve_pages", "gauge", "Policy pages withheld from further admission.", i.reserve_pages.?);
+    try gauge(w, "anvil_full_context_admission_limit", "gauge", "Policy request admission limit.", i.admission_limit.?);
+    try gauge(w, "anvil_full_context_active_requests", "gauge", "Requests already consuming admission slots.", i.active_requests.?);
+}
