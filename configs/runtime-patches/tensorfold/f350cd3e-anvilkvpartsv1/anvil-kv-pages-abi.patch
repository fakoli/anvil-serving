+        .kv_allocation = if (set.pages and !set.kv_shard.on) .{ .ctx = own, .read = readKvAllocation } else null,
         .kv_parts = if (set.kv_shard.on) .{ .ctx = own, .read = readKvParts } else null,
     };
 }
 
+/// Read the leader's logical page census on its engine thread; replicas are not summed.
+fn readKvAllocation(ctx: *anyopaque) ?lanes.anvil_telemetry.KvAllocation {
+    const own: *Owned = @ptrCast(@alignCast(ctx));
+    const p = own.e.pages orelse return null;
+    if (!p.leader or p.shard != null) return null;
+    const census = p.pool.census();
+    return .{ .allocated_pages = census.total - census.free, .free_pages = census.free,
+        .total_pages = census.total, .reserved_pages = census.promised, .page_size_tokens = p.layout.page_tokens };
+}
