+fn anvilKv(w: *std.Io.Writer, allocation: ?api.anvil_telemetry.KvAllocation) !void {
+    const available = if (allocation) |k| k.valid() else false;
+    try gauge(w, "anvil_kv_allocation_available", "gauge", "One only when complete logical decode-KV page allocation is available.", @intFromBool(available));
+    if (!available) return;
+    const k = allocation.?;
+    try w.writeAll("# TYPE tensorfold:anvil_kv_pool_info gauge\ntensorfold:anvil_kv_pool_info{scope=\"global_logical_decode_kv_pool\"} 1\n");
+    try gauge(w, "anvil_kv_pool_partitions", "gauge", "Independent admission partitions in this logical pool.", 1);
+    inline for (@typeInfo(api.anvil_telemetry.KvAllocation).@"struct".field_names) |name| {
+        try gauge(w, "anvil_kv_" ++ name, "gauge", "Logical decode-KV allocation; pages or token positions as named.", @field(k, name));
+    }
+}
+
+test "Anvil KV missing and invalid allocation never becomes zero capacity" {
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+    try anvilKv(&out.writer, null);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_kv_allocation_available 0\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "anvil_kv_total_pages ") == null);
+    out.clearRetainingCapacity();
+    try anvilKv(&out.writer, .{ .allocated_pages = 2, .free_pages = 8, .total_pages = 10, .reserved_pages = 3, .page_size_tokens = 512 });
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_kv_page_size_tokens 512\n") != null);
+}
