 /// A sharded KV pool's families (GLM's TF_GLM_KV_SHARD): `kv_shard_*` gauges and counters, then each part's pages.
 pub fn kvShard(w: *std.Io.Writer, k: api.Status.KvParts) !void {
     const S = api.Status.KvParts;
