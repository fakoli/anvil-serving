@@ -0,0 +1,29 @@
+//! Anvil telemetry ABI v1: logical decode-KV pages, never prompt-cache byte budgets.
+const std = @import("std");
+pub const KvAllocation = struct {
+    allocated_pages: u64,
+    free_pages: u64,
+    total_pages: u64,
+    reserved_pages: u64,
+    page_size_tokens: u64,
+
+    pub fn valid(k: KvAllocation) bool {
+        return k.page_size_tokens > 0 and k.allocated_pages <= k.total_pages and
+            k.free_pages == k.total_pages - k.allocated_pages and k.reserved_pages <= k.free_pages;
+    }
+};
+pub const KvSource = struct {
+    ctx: *anyopaque,
+    read: *const fn (*anyopaque) ?KvAllocation,
+};
+
+test "global decode KV validates pages and promises, not prompt-cache bytes" {
+    const k: KvAllocation = .{ .allocated_pages = 2, .free_pages = 8, .total_pages = 10, .reserved_pages = 3, .page_size_tokens = 512 };
+    try std.testing.expect(k.valid());
+    var bad = k;
+    bad.reserved_pages = 9;
+    try std.testing.expect(!bad.valid());
+    bad = k;
+    bad.free_pages = 10;
+    try std.testing.expect(!bad.valid());
+}
