+/// Unique leader-owned pools, never tensor-parallel copies. Twins already occupy allocated pages.
+pub fn combinePartitions(parts: []const KvAllocation) ?KvAllocation {
+    if (parts.len == 0 or parts.len > 2) return null;
+    var result: KvAllocation = .{ .allocated_pages = 0, .free_pages = 0, .total_pages = 0,
+        .reserved_pages = 0, .page_size_tokens = parts[0].page_size_tokens, .partitions = parts.len };
+    for (parts) |part| {
+        if (!part.valid() or part.partitions != 1 or part.page_size_tokens != result.page_size_tokens) return null;
+        inline for (.{ "allocated_pages", "free_pages", "total_pages", "reserved_pages", "temporary_twin_pages" }) |field| {
+            @field(result, field) = std.math.add(u64, @field(result, field), @field(part, field)) catch return null;
+        }
+    }
+    return if (result.valid()) result else null;
+}
