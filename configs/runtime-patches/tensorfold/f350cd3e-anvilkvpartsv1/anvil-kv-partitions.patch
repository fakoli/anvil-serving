+    parts[1].temporary_twin_pages = 0;
+    parts[1].page_size_tokens = 256;
+    try std.testing.expect(combinePartitions(&parts) == null);
+    parts[1] = .{ .allocated_pages = 0, .free_pages = std.math.maxInt(u64), .total_pages = std.math.maxInt(u64), .reserved_pages = 0, .page_size_tokens = 512 };
+    try std.testing.expect(combinePartitions(&parts) == null);
