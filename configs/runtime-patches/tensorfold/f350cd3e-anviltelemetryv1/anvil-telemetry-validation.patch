diff --git a/zig/src/core/lane_host_anvil_test.zig b/zig/src/core/lane_host_anvil_test.zig
new file mode 100644
index 00000000..60a9d13e
--- /dev/null
+++ b/zig/src/core/lane_host_anvil_test.zig
@@ -0,0 +1,205 @@
+//! CPU fake backend exercises the production submit, admission, prefill, token and publication seams.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const Host = @import("lane_host.zig").LaneHost;
+const publication = @import("lane_host_status.zig");
+
+fn event(_: *anyopaque, _: api.Id, _: *const api.Event) void {}
+
+test "Anvil production lane host idle C1 C4 timing and stream completeness" {
+    const a = std.testing.allocator;
+    for ([_]u32{ 0, 1, 4 }) |count| {
+        var cfg = try lanes.Config.init(a, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        defer cfg.deinit(a);
+        var target: lanes.fake.Fake = .{ .gpa = a };
+        defer target.deinit();
+        var clock: lanes.fake.FixedClock = .{};
+        var core = lanes.Engine.init(a, &cfg, target.backend(), clock.clock());
+        defer core.deinit();
+        var host = Host.init(a, std.testing.io, &core, .{ .lanes = 4 });
+        defer host.stop();
+        var sink_context: u8 = 0;
+        const request: api.Request = .{ .prompt = &.{ 3, 1, 4, 1, 5, 9 }, .max_tokens = 32 };
+        const engine = host.engine();
+        for (0..count) |index| try engine.submit(index, &request, .{ .ctx = &sink_context, .event = event });
+        while (host.queued.items.len > 0) _ = host.admitOne();
+        publication.noteLive(&host);
+        var status: api.Status = .{};
+        var streams: [4]u32 = undefined;
+        engine.status(&status, &streams);
+        try std.testing.expectEqual(@as(usize, count), status.streams_active.?);
+        try std.testing.expectEqual(@as(usize, count), status.streams);
+        try std.testing.expect(status.streams_complete);
+        const timing = status.anvil_timing.?;
+        try std.testing.expectEqual(@as(u64, count), timing.arrivals);
+        try std.testing.expectEqual(@as(u64, count), timing.admissions);
+        try std.testing.expectEqual(@as(u64, count), timing.prefill_started);
+        try std.testing.expectEqual(@as(u64, count), timing.first_tokens);
+        try std.testing.expectEqual(@as(u64, count), timing.arrival_to_admission.n);
+        try std.testing.expectEqual(@as(u64, count), timing.admission_to_prefill.n);
+        try std.testing.expectEqual(@as(u64, count), timing.prefill_to_first_token.n);
+        if (count == 4) {
+            engine.status(&status, streams[0..1]);
+            try std.testing.expect(!status.streams_complete);
+            try std.testing.expectEqual(@as(usize, 4), status.streams_active.?);
+            try std.testing.expectEqual(@as(usize, 1), status.streams);
+        }
+        if (count > 0) {
+            host.lock();
+            host.admitted.items[0].noteAdmission(); // a retry must not count first admission twice
+            host.unlock();
+            host.notePrefillStart(host.admitted.items[0]);
+            try std.testing.expectEqual(timing.admissions, host.anvil_timing.admissions);
+            try std.testing.expectEqual(timing.prefill_started, host.anvil_timing.prefill_started);
+        }
+        while (host.admitted.items.len > 0) _ = host.drop(host.admitted.items[0], "test completion");
+        publication.noteLive(&host);
+        engine.status(&status, &streams);
+        try std.testing.expectEqual(@as(usize, 0), status.streams_active.?);
+        try std.testing.expect(status.streams_complete);
+        try engine.submit(100, &request, .{ .ctx = &sink_context, .event = event });
+        const cancelled = host.queued.orderedRemove(0);
+        host.finish(cancelled, .cancelled, "before admission");
+        try std.testing.expectEqual(@as(u64, count + 1), host.anvil_timing.arrivals);
+        try std.testing.expectEqual(@as(u64, count), host.anvil_timing.admissions);
+        try std.testing.expectEqual(@as(u64, count), host.anvil_timing.first_tokens);
+    }
+}
+
+test "Anvil first-token commitment precedes a delayed sibling draw and batched sink delivery" {
+    const a = std.testing.allocator;
+    const Target = struct {
+        fake: lanes.fake.Fake = .{ .gpa = a },
+        table: lanes.backend.Backend.VTable = undefined,
+        host: *Host = undefined,
+        draws: usize = 0,
+        emitted: usize = 0,
+        observed_commit_before_sibling: bool = false,
+        fn first(ptr: *anyopaque, stream: *lanes.Stream, position: u64) !u64 {
+            const fake: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            const t: *@This() = @fieldParentPtr("fake", fake);
+            t.draws += 1;
+            if (t.draws == 2) {
+                t.observed_commit_before_sibling = t.host.anvil_timing.first_tokens == 1 and t.emitted == 0;
+                try std.Io.sleep(std.testing.io, .fromMilliseconds(20), .awake);
+            }
+            return t.fake.batched().vtable.first(ptr, stream, position);
+        }
+        fn sink(ptr: *anyopaque, _: api.Id, ev: *const api.Event) void {
+            const t: *@This() = @ptrCast(@alignCast(ptr));
+            if (ev.* == .tokens) t.emitted += ev.tokens.len;
+        }
+    };
+    var target: Target = .{};
+    defer target.fake.deinit();
+    target.table = target.fake.batched().vtable.*;
+    target.table.first = Target.first;
+    var cfg = try lanes.Config.init(a, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(a);
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(a, &cfg, .{ .ptr = &target.fake, .vtable = &target.table }, clock.clock());
+    defer core.deinit();
+    var host = Host.init(a, std.testing.io, &core, .{ .lanes = 4 });
+    target.host = &host;
+    defer host.stop();
+    const request: api.Request = .{ .prompt = &.{ 3, 1, 4, 1, 5, 9 }, .max_tokens = 32 };
+    const engine = host.engine();
+    for (0..4) |index| try engine.submit(index, &request, .{ .ctx = &target, .event = Target.sink });
+    try std.testing.expect(host.admitOne());
+    try std.testing.expectEqual(@as(usize, 1), target.fake.many_passes);
+    try std.testing.expect(target.observed_commit_before_sibling);
+    try std.testing.expectEqual(@as(u64, 4), host.anvil_timing.first_tokens);
+    while (host.admitted.items.len > 0) _ = host.drop(host.admitted.items[0], "test completion");
+}
+
+test "Anvil refused batch timestamps each serial prefill only when its backend starts" {
+    const a = std.testing.allocator;
+    const Target = struct {
+        fake: lanes.fake.Fake = .{ .gpa = a },
+        table: lanes.backend.Backend.VTable = undefined,
+        host: *Host = undefined,
+        calls: usize = 0,
+        correctly_ordered: bool = true,
+        fn many(_: *anyopaque, _: []const *lanes.Stream) !bool { return false; }
+        fn prefill(ptr: *anyopaque, stream: *lanes.Stream) !void {
+            const fake: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            const t: *@This() = @fieldParentPtr("fake", fake);
+            t.calls += 1;
+            t.correctly_ordered = t.correctly_ordered and t.host.anvil_timing.prefill_started == t.calls;
+            if (t.calls == 2) try std.Io.sleep(std.testing.io, .fromMilliseconds(20), .awake);
+            return t.fake.backend().vtable.prefill(ptr, stream);
+        }
+    };
+    var target: Target = .{};
+    defer target.fake.deinit();
+    target.table = target.fake.batched().vtable.*;
+    target.table.prefill_many = Target.many;
+    target.table.prefill = Target.prefill;
+    var cfg = try lanes.Config.init(a, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(a);
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(a, &cfg, .{ .ptr = &target.fake, .vtable = &target.table }, clock.clock());
+    defer core.deinit();
+    var host = Host.init(a, std.testing.io, &core, .{ .lanes = 4 });
+    target.host = &host;
+    defer host.stop();
+    var sink_context: u8 = 0;
+    const request: api.Request = .{ .prompt = &.{ 3, 1, 4, 1, 5, 9 }, .max_tokens = 32 };
+    for (0..4) |index| try host.engine().submit(index, &request, .{ .ctx = &sink_context, .event = event });
+    try std.testing.expect(host.admitOne());
+    try std.testing.expectEqual(@as(usize, 4), target.calls);
+    try std.testing.expect(target.correctly_ordered);
+    try std.testing.expectEqual(@as(u64, 4), host.anvil_timing.admission_to_prefill.n);
+    while (host.admitted.items.len > 0) _ = host.drop(host.admitted.items[0], "test completion");
+}
+
+test "Anvil fully restored prompt final passes mark actual dispatch without early serial siblings" {
+    const a = std.testing.allocator;
+    const Watch = struct {
+        begun: usize = 0,
+        calls: usize = 0,
+        correct: bool = true,
+        fn start(ptr: *anyopaque) void {
+            const w: *@This() = @ptrCast(@alignCast(ptr));
+            w.begun += 1;
+        }
+        fn finals(ptr: *anyopaque, streams: []const *lanes.Stream) !void {
+            const w: *@This() = @ptrCast(@alignCast(ptr));
+            w.correct = w.correct and w.begun == streams.len;
+        }
+        fn finish(ptr: *anyopaque, _: *lanes.Stream) !void {
+            const w: *@This() = @ptrCast(@alignCast(ptr));
+            w.calls += 1;
+            w.correct = w.correct and w.begun == w.calls;
+            return error.EndTestBeforeDraw;
+        }
+    };
+    var cfg = try lanes.Config.init(a, .{ .exact_width = 8, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(a);
+    cfg.replay_runs = true;
+    var watch: Watch = .{};
+    var target: lanes.fake.Fake = .{ .gpa = a };
+    defer target.deinit();
+    var table = target.backend().vtable.*;
+    table.finals = Watch.finals;
+    table.finish = Watch.finish;
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(a, &cfg, .{ .ptr = &watch, .vtable = &table }, clock.clock());
+    defer core.deinit();
+    var first = try lanes.Stream.init(a, .{ .id = "first", .prompt = &.{ 1, 2 }, .max_new = 4 });
+    defer first.deinit(a);
+    var second = try lanes.Stream.init(a, .{ .id = "second", .prompt = &.{ 1, 2 }, .max_new = 4 });
+    defer second.deinit(a);
+    first.prefill_start_observer = .{ .ptr = &watch, .call = Watch.start };
+    second.prefill_start_observer = .{ .ptr = &watch, .call = Watch.start };
+    try core.prepareFinals(&.{ &first, &second });
+    try std.testing.expect(watch.correct);
+    watch = .{};
+    first.prefill_start_observer = .{ .ptr = &watch, .call = Watch.start };
+    second.prefill_start_observer = .{ .ptr = &watch, .call = Watch.start };
+    var errs: [2]?anyerror = undefined;
+    _ = try core.finishStreams(&.{ &first, &second }, &errs);
+    try std.testing.expect(watch.correct);
+    try std.testing.expectEqual(@as(usize, 2), watch.calls);
+}
