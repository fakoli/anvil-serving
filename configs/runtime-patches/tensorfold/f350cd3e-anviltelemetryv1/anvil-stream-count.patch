+/// Anvil telemetry ABI v1. Stream indices identify positions only within this publication.
+fn anvilStreams(w: *std.Io.Writer, status: api.Status, streams: []const u32) !void {
+    try w.writeAll("# HELP tensorfold:anvil_contract_info Anvil telemetry contract version.\n# TYPE tensorfold:anvil_contract_info gauge\ntensorfold:anvil_contract_info{version=\"1\"} 1\n");
+    try gauge(w, "anvil_streams_observed", "gauge", "Started streams with context-token observations in this snapshot.", streams.len);
+    try gauge(w, "anvil_streams_complete", "gauge", "One only if every active stream is observed and current request counts agree.", @intFromBool(status.streams_complete and status.streams_active != null and status.streams_active.? == streams.len));
+    if (status.streams_active) |active| try gauge(w, "anvil_streams_active", "gauge", "Started streams in the engine-thread publication; omitted when unavailable.", active);
+    try family(w, "anvil_stream_context_tokens", "gauge", "Context tokens held by each observed stream; indices are local to this snapshot.");
+    for (streams, 0..) |tokens, index| try w.print("{s}anvil_stream_context_tokens{{stream=\"{d}\"}} {d}\n", .{ prefix, index, tokens });
+}
+
+test "Anvil stream ABI preserves idle, C1, C4 and incomplete observations" {
+    const a = std.testing.allocator;
+    for ([_]usize{ 0, 1, 4 }) |count| {
+        var out: std.Io.Writer.Allocating = .init(a);
+        defer out.deinit();
+        const tokens = [_]u32{ 10, 20, 30, 40 };
+        try anvilStreams(&out.writer, .{ .streams_active = count, .streams_complete = true }, tokens[0..count]);
+        try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_streams_complete 1\n") != null);
+    }
+    var out: std.Io.Writer.Allocating = .init(a);
+    defer out.deinit();
+    try anvilStreams(&out.writer, .{ .streams_active = 4, .streams_complete = false }, &.{10});
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_streams_complete 0\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_streams_active 4\n") != null);
+    out.clearRetainingCapacity();
+    try anvilStreams(&out.writer, .{}, &.{});
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "tensorfold:anvil_streams_active ") == null);
+}
