+def _pin_mmap_region_enabled() -> bool:
+    """Keep V2 UVA enabled while allowing WSL2 to skip mmap registration."""
+    value = os.getenv("VLLM_KV_OFFLOAD_MMAP_PIN_MEMORY", "1").strip().lower()
+    if value in {"1", "true", "yes", "on"}:
+        return True
+    if value in {"0", "false", "no", "off"}:
+        return False
+    raise ValueError(
