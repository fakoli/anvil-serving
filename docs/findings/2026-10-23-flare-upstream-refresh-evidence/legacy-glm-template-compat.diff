+
+#[test]
+fn legacy_glm_preserves_prompt_tokens_and_rendered_tool_boundaries() {
+    let source = include_str!("../../ignition/recipes/glm53/assets/chat_template.jinja");
+    let annotated = frontend(source, TemplateEncoding::Text);
+    let upgraded = frontend(&source.replace("{%- mark -%}", ""), TemplateEncoding::Text);
+    let options = json!({"add_generation_prompt":true,"reasoning_effort":"low"});
+    let histories = [
+        json!([
+            {"role":"system","content":"Be precise. café 世界"},
+            {"role":"user","content":"Question"},
+            {"role":"assistant","reasoning_content":"Consider.","content":"Reply."},
+            {"role":"user","content":"Follow-up"}
+        ]),
+        json!([
+            {"role":"user","content":"Find both."},
+            {"role":"assistant","content":"","tool_calls":[
+                {"id":"a","type":"function","function":{"name":"lookup","arguments":{"q":"first"}}},
+                {"id":"b","type":"function","function":{"name":"lookup","arguments":{"q":"second"}}}
+            ]},
+            {"role":"tool","tool_call_id":"b","content":"Second 世界"},
+            {"role":"tool","tool_call_id":"a","content":"First café"},
+            {"role":"user","content":"Follow-up"}
+        ]),
+    ];
+    for (index, history) in histories.iter().enumerate() {
+        let messages = history.as_array().unwrap();
+        let expected = annotated.render_chat(messages, options.as_object().unwrap()).unwrap();
+        let actual = upgraded.render_chat(messages, options.as_object().unwrap()).unwrap();
+        assert_eq!(actual.text, expected.text);
+        assert_eq!(actual.token_ids, expected.token_ids);
+        assert_eq!(actual.message_boundaries, expected.message_boundaries);
+        assert!(!actual.message_boundaries.is_empty());
+        assert!(actual.message_boundaries.windows(2).all(|pair| pair[0] < pair[1]));
+        assert!(actual.message_boundaries.iter().all(|&end| end < actual.token_ids.len()));
+        if index == 0 {
+            assert_eq!(actual.text, concat!(
+                "[gMASK]<sop><|system|>Reasoning Effort: Low",
+                "<|system|>Be precise. café 世界<|user|>Question",
+                "<|assistant|><think>Consider.</think>Reply.",
+                "<|user|>Follow-up<|assistant|><think>"
+            ));
+        } else {
+            // Tool results arrive in reverse order but marks follow the rendered call order.
+            let first = "<tool_response>First café</tool_response>";
+            let second = "<tool_response>Second 世界</tool_response>";
+            let first_at = actual.text.find(first).unwrap();
+            let second_at = actual.text.find(second).unwrap();
+            assert!(first_at < second_at);
+            for end in [first_at + first.len(), second_at + second.len()] {
+                let prefix = upgraded.encode(&actual.text[..end], false).unwrap();
+                assert!(actual.message_boundaries.contains(&prefix.len()));
+                assert!(actual.token_ids.starts_with(&prefix));
+            }
+        }
+        let cut = actual.text.rfind("<|user|>").unwrap();
+        let prefix = upgraded.encode(&actual.text[..cut], false).unwrap();
+        assert!(actual.message_boundaries.contains(&prefix.len()));
+        let mut changed = messages.clone();
+        changed.last_mut().unwrap()["content"] = json!("Different suffix");
+        let changed = upgraded.render_chat(&changed, options.as_object().unwrap()).unwrap();
+        assert!(changed.token_ids.starts_with(&prefix));
+        assert!(changed.message_boundaries.contains(&prefix.len()));
+    }
+}
