{
  "schema": "anvil-serving.benchmark-graph-manifest/v1",
  "title": "GLM EXL3 TP2 baseline: descriptive capacity scout",
  "subtitle": "Unique-cache code32/canaries; C1 N4/3/3 and separate C4 N8. Targets are prompt construction labels; actual prompt counts are retained in each native artifact. No challenger speed or p99 claim.",
