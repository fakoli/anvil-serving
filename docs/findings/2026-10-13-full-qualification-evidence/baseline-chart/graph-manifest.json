  "data_output": "baseline-capacity-graph-data.json",
  "metric_semantics": {
    "population": "Four complete strict controlled-output32-word cells; sample sizes4,8,3,3. Decode/throughput count completion usage including reasoning; TPOT is aggregate proxy, not raw token-arrival ITL.",
    "comparison_limit": "Same incumbent runtime/quant/TP2. Different context targets and concurrency remain separate; small-sample descriptive figures, not service-level tails. Actual prompt means 25,280.5/25,281.125/106,520/216,194.667 tokens, not full advertised targets."
