+#[test]
+fn host_admission_metrics_distinguish_cost_capacity_and_fetch_outcomes() {
+    for outcome in ["accepted", "cost", "capacity", "rejected", "failed"] {
+        let fixture = Fixture::new();
+        let (sender, receiver) = mpsc::channel();
+        let (incoming, _generation) = fixture.incoming(vec![0; 70], 4);
+        let mut history = crate::cache::PrefixHistory::new(fixture.config.identity);
+        history.append(&incoming.prompt.tokens, &[]).unwrap();
+        let mut hit = host_hit(&history, 70);
+        if outcome == "cost" {
+            hit.estimated_seconds = f64::MAX;
+        }
+        let mut store = FakeStore::new(Some(hit));
+        store.reject_fetch = outcome == "rejected";
+        sender.send(vec![incoming]).unwrap();
+        let mut worker = fixture.worker(receiver);
+        if outcome == "capacity" {
+            worker.scheduler.share_snapshot_pages(&vec![0..16; 16]).unwrap();
+        }
+        worker.attach_store(Some(Box::new(store)));
+        assert_eq!(worker.admit().unwrap(), ControlFlow::Continue(true));
+        if outcome == "failed" {
+            let (_, ticket) = fake_store(&mut worker).fetched.pop().unwrap();
+            fake_store(&mut worker).events.push_back(crate::offload::StoreEvent::Fetched {
+                key: ticket.key,
+                result: Err("transfer failed".into()),
+            });
+            worker.service_store().unwrap();
+            assert_eq!(worker.admit().unwrap(), ControlFlow::Continue(true));
+            worker.service_store().unwrap();
+        }
+        let text = fixture.metrics.render();
+        for (name, expected) in [
+            ("raw_lookup_match", 1),
+            ("cost_rejected", u64::from(outcome == "cost")),
+            ("capacity_rejected", u64::from(outcome == "capacity")),
+            ("fetch_admitted", u64::from(matches!(outcome, "accepted" | "failed"))),
+            ("fetch_failed", u64::from(matches!(outcome, "rejected" | "failed"))),
+        ] {
+            let metric = format!("flare_host_cache_admission_{name}_total");
+            assert!(text.contains(&format!("# TYPE {metric} counter\n")));
+            assert!(text.contains(&format!("\n{metric} {expected}\n")), "{outcome}: {metric}");
+        }
+    }
+}
