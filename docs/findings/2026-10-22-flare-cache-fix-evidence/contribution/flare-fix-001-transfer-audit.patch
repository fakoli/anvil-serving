+/// Scratch and counters belong to one rank thread. No payload bytes enter logs.
+struct Verification {
+    readback: PinnedHost,
+    expected: Vec<u8>,
+    checked_bytes: u64,
+    checked_copies: u64,
+    failures: u64,
+}
+
+fn verify_bytes(expected: &[u8], actual: &[u8]) -> Result<()> {
+    if expected.len() != actual.len() || expected != actual {
+        return Err(invalid("host cache transfer verification mismatch"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod verification_tests {
+    use super::verify_bytes;
+
+    #[test]
+    fn detects_corruption_without_exposing_payload() {
+        assert!(verify_bytes(&[1, 2, 3], &[1, 2, 3]).is_ok());
+        let error = verify_bytes(&[1, 2, 3], &[1, 9, 3])
+            .unwrap_err()
+            .to_string();
+        assert_eq!(error, "host cache transfer verification mismatch");
+        assert!(verify_bytes(&[1, 2], &[1, 2, 3]).is_err());
+    }
+}
+
+impl Verification {
+    fn host_bytes(stream: &Stream, address: u64, bytes: usize) -> Result<&[u8]> {
+        let address =
+            usize::try_from(address).map_err(|_| invalid("host cache address exceeds usize"))?;
+        let host = stream
+            .mapped_host_address(address, bytes)?
+            .ok_or_else(|| invalid("host cache transfer expected mapped host storage"))?;
+        // SAFETY: CUDA resolved both endpoints to one host allocation, and the
+        // submitting store keeps that allocation live through the rank reply.
+        Ok(unsafe { std::slice::from_raw_parts(host as *const u8, bytes) })
+    }
+
+    fn download(
+        &mut self,
+        stream: &Stream,
+        event: &Event,
+        address: u64,
+        bytes: usize,
+    ) -> Result<()> {
+        let address =
+            usize::try_from(address).map_err(|_| invalid("device cache address exceeds usize"))?;
+        // SAFETY: expand bounded this descriptor within the live device allocation.
+        unsafe {
+            stream.download(&self.readback, address, bytes)?;
+        }
+        stream.record(event)?;
+        event.synchronize()?;
+        Ok(())
+    }
+
+    fn capture(
+        &mut self,
+        stream: &Stream,
+        event: &Event,
+        descriptors: &[Descriptor],
+        direction: Direction,
+    ) -> Result<()> {
+        self.expected.clear();
+        for descriptor in descriptors {
+            let next = self
+                .expected
+                .len()
+                .checked_add(descriptor.bytes)
+                .filter(|&n| n <= BATCH_BYTES)
+                .ok_or_else(|| invalid("verification batch exceeds scratch capacity"))?;
+            match direction {
+                Direction::Out => {
+                    self.download(stream, event, descriptor.source, descriptor.bytes)?;
+                    self.expected
+                        .extend_from_slice(&self.readback.bytes()[..descriptor.bytes]);
+                }
+                Direction::In => self.expected.extend_from_slice(Self::host_bytes(
+                    stream,
+                    descriptor.source,
+                    descriptor.bytes,
+                )?),
+            }
+            debug_assert_eq!(self.expected.len(), next);
+        }
+        Ok(())
+    }
+
+    fn compare(
+        &mut self,
+        stream: &Stream,
+        event: &Event,
+        descriptors: &[Descriptor],
+        direction: Direction,
+    ) -> Result<()> {
+        let mut offset = 0usize;
+        for descriptor in descriptors {
+            let end = offset
+                .checked_add(descriptor.bytes)
+                .ok_or_else(|| invalid("verification descriptor offset overflows"))?;
+            if self.expected.get(offset..end).is_none() {
+                return Err(invalid("verification descriptor exceeds captured bytes"));
+            }
+            match direction {
+                Direction::Out => verify_bytes(
+                    &self.expected[offset..end],
+                    Self::host_bytes(stream, descriptor.destination, descriptor.bytes)?,
+                )?,
+                Direction::In => {
+                    self.download(stream, event, descriptor.destination, descriptor.bytes)?;
+                    verify_bytes(
+                        &self.expected[offset..end],
+                        &self.readback.bytes()[..descriptor.bytes],
+                    )?;
+                }
+            }
+            self.checked_bytes += descriptor.bytes as u64;
+            self.checked_copies += 1;
+            offset = end;
+        }
+        Ok(())
+    }
 }
 
