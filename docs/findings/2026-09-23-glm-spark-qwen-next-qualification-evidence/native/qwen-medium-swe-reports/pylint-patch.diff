+def _split_multiple_regexes(value: str) -> list[str]:
+    """Split a string of regular expressions on commas that are not part of
+    the regular expressions themselves.
+
+    A comma is only used as a separator when it is not nested inside a group
+    (parentheses, square brackets or curly braces) and is not escaped with a
+    backslash. Empty parts are discarded.
+    """
+    parts: list[str] = []
+    current: list[str] = []
+    nesting_level = 0
+    escaped = False
+    for char in value:
+        if escaped:
+            current.append(char)
+            escaped = False
+        elif char == "\\":
+            current.append(char)
+            escaped = True
+        elif char in "([{":
+            current.append(char)
+            nesting_level += 1
+        elif char in ")]}":
+            current.append(char)
+            nesting_level = max(nesting_level - 1, 0)
+        elif char == "," and nesting_level == 0:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    parts.append("".join(current))
+    return [part.strip() for part in parts if part.strip()]
+
