{
  "schema": "anvil-serving.benchmark-graph-manifest/v1",
  "title": "Qwen3.8 27B RTX PRO 6000 finalist matrix",
  "subtitle": "Direct online 4K/C8 fixed-output n=100 comparisons; TP1 and TP2 are labeled separately; DP2 appears only in the two-GPU aggregate panel; 82K/C8 panels are n=8; no promotion",
  "output": "benchmark-matrix.svg",
  "data_output": "benchmark-graph-data.json",
  "metric_semantics": {
    "comparison_set": "The 4K/C8 panels use the retained 100-request fixed-output canary artifacts for the Inferact SGLang K12 finalist, RadixArk SGLang K8, Inferact SGLang TP2 K12, and kelnei vLLM 0.27.1 MTP2/no-speculation profiles.",
    "topology": "TP1 is one RTX PRO 6000. TP2 is one service spanning two RTX PRO 6000 GPUs. DP2 is two independent TP1 replicas and is shown only in the dedicated two-GPU aggregate-throughput panel.",
    "percentiles": "p50 and p99 are calculated over 100 successful requests in the fixed-output 4K/C8 cells. The separate 82K/C8 collapse panels contain eight successful requests per supported configuration and therefore show p50 only.",
    "ttft": "Client-observed request start through first non-empty streamed content delta.",
    "effective_prefill": "Prompt tokens divided by client-observed TTFT; includes queueing, scheduling, prefill, and first-token work.",
    "decode": "Completion tokens after the first token divided by client-observed generation time; completion tokens may include reasoning tokens.",
    "tpot": "Generation time divided by completion tokens after the first token.",
    "mean_itl": "The capacity-v3 aggregate uses the same per-request calculation as TPOT; this is not a raw timestamp for every token.",
    "e2e": "Client-observed request start through stream completion.",
    "aggregate": "Total completion tokens divided by wall-clock duration for the retained cell. DP2 plots the conservative 1401.8 tok/s lower bound; legacy whole-second replica timestamps support 1401.8–1423.4 tok/s, not exact alignment."
  },
  "charts": [
